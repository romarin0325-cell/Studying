u":6,"note":"후보 원본에서 노출 창과 동공을 확인했고 동일 사각형의 RGBA가 편집 전과 전부 일치한다."},{"box":[243,242,315,318],"eye":[292,280],"u":6,"note":"후보 원본에서 노출 창과 동공을 확인했고 동일 사각형의 RGBA가 편집 전과 전부 일치한다."}]},"core":{"sourceHash":"ffc7ded1a2f12ea19b36ad7daf586b74547a99ec2f7eb3a4ddfe6613a78dc8bc","views":[{"crown":[249,138],"chin":[235,314],"span":[146,349],"tip":[243,114],"kind":"hair","u":[5,3]},null,{"crown":[269,138],"chin":[219,318],"span":[160,357],"tip":[242,116],"kind":"hair","u":[5,3]},{"crown":[244,139],"chin":[281,318],"span":[156,349],"tip":[266,118],"kind":"hair","u":[5,3]}],"decision":"keep","side":"양 측면","note":"두 측면의 짙은 윗머리 호가 정면 높이로 올라왔다. 가는 한 가닥은 윗호와 떨어져 있다. 동공·볼·턱은 원래 위치에 남아 한쪽 눈과 곰 인형이 자연스럽게 이어진다. 새 윗부분은 표면 광택이 기존 정면보다 조금 부드럽다.","action":"교정한 양 측면을 채택했습니다. 가닥과 주머리를 별도로 표시하면 정면선까지 회복된 부분을 볼 수 있습니다."},"measure":{"source":"defense/docs/art/turnaround-20261120/review.json","views":[{"skull":[245.16,237,159.45,150.52,-7],"chin":[243.24,312.26],"sole":[256,480],"eyes":[],"crownY":161.67,"shoulders":null,"hips":null,"anatomicalHeight":318.33,"belowChin":167.74,"skullUncertainty":11.48,"heightUncertainty":14.67},{"skull":[261.1,235.73,159.45,150.52,0],"chin":[261.1,310.98],"sole":[256,480],"eyes":[],"crownY":160.47,"shoulders":null,"hips":null,"anatomicalHeight":319.53,"belowChin":169.02,"skullUncertainty":16.58,"heightUncertainty":19.77},{"skull":[255,240,145,150,0],"chin":[219,318],"sole":[256,480],"eyes":[[222,280]],"shoulders":[258,331],"hips":[263,402],"crownY":165,"anatomicalHeight":315,"belowChin":162,"skullUncertainty":17,"heightUncertainty":21},{"skull":[253,240,145,150,0],"chin":[281,318],"sole":[256,480],"eyes":[[292,280]],"shoulders":[249,331],"hips":[248,402],"crownY":165,"anatomicalHeight":315,"belowChin":162,"skullUncertainty":17,"heightUncertainty":21}],"heightClass":"short","heightClassSource":"defense/src/data.js","targetBelowChin":176,"bodyFrame":"neutral","note":"양 측면의 두개골은 머리카락 아래 추정치(±17px)입니다. 칠해진 윗머리는 별도로 찍었습니다."},"revision":{"previous":{"id":"prev_phantom","nam