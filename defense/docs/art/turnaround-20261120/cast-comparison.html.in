80],"eyes":[[201,244]],"crownY":134,"shoulders":[243,315],"hips":[238,391],"anatomicalHeight":346,"belowChin":197,"skullUncertainty":12,"heightUncertainty":null},{"skull":[274.31,211.23,145.18,143.87,0],"chin":[305.05,283.16],"sole":[256,480],"eyes":[[290,248]],"crownY":139.29,"shoulders":[251,317],"hips":[254,386],"anatomicalHeight":340.71,"belowChin":196.84,"skullUncertainty":11.77,"heightUncertainty":15.04}],"heightClass":"medium","heightClassSource":"defense/src/data.js","targetBelowChin":188,"bodyFrame":null,"note":"좌측 볼·턱이 우측보다 둥글게 보일 수 있다는 설치 기록이 있습니다."},"optics":{"views":[{"box":[189,188,300,284],"eye":[242,239],"u":6,"note":""},null,{"box":[183,202,248,284],"eye":[203,244],"u":6,"note":""},{"box":[241,206,313,287],"eye":[292,248],"u":6,"note":""}],"sourceHash":"dac8f3a4ed7b3ad183af697402d322eeb70b69aa26a8f4220026c99b0f20b07f"},"core":{"sourceHash":"dac8f3a4ed7b3ad183af697402d322eeb70b69aa26a8f4220026c99b0f20b07f","views":[{"crown":[255,106],"chin":[240,284],"span":[138,346],"tip":[234,81],"kind":"hair","u":[5,3]},null,{"crown":[246,120],"chin":[206,284],"span":[151,328],"tip":[221,89],"kind":"hair","u":[6,3]},{"crown":[239,129],"chin":[290,288],"span":[150,339],"tip":[269,110],"kind":"hair","u":[6,3]}],"decision":"repair","side":"오른쪽 우선","note":"정면의 둥근 갈색 윗선과 오른쪽의 잔머리 끝은 4px 차이입니다. 오른쪽 머리 본체는 23px 아래에 있고 턱은 4px 아래에 있어 높이가 19px 줄어듭니다. 왼쪽은 윗선이 14px 낮지만 턱 높이는 정면과 같습니다.","action":"정면과 왼쪽을 보존한 첫 시안에서 오른쪽의 둥근 윗머리·뒤통수 높이를 복원합니다. 오른쪽 눈과 지팡이 가림을 보존하고 왼쪽은 시안과 다시 비교합니다."}},"protectedText":"기존 #672의 왼쪽과 정면·후면, 오른쪽 얼굴·동공·턱·지팡이를 보존했습니다. 오른쪽 동공은 정면보다 9px 아래입니다.","evidence":"defense/docs/art/turnaround-20261120/README.md","formal":{"pass":15,"caution":2},"flags":{"before":7,"after":7},"formalPath":"defense/docs/art/turnaround-20261120/time_magician/formal-review.json"}},{"id":"ancient_dragon","name":"에인션트드래곤","kind":"hero","parent":null,"rarity":"SR","hidden":false,"heightGroup":"tall","atlasKey":"unit-ancient_dragon","foot":0.9375,"renderScale":1,"portrait":{"x":252,"y":2