2],"span":[148,349],"tip":[226,104],"kind":"hair","u":[4,3]},null,{"crown":[255,143],"chin":[217,299],"span":[169,356],"tip":[234,121],"kind":"hair","u":[4,3]},{"crown":[246,143],"chin":[281,296],"span":[142,332],"tip":[266,120],"kind":"hair","u":[4,3]}],"decision":"repair","side":"양 측면","note":"정면에 비해 양측의 흰 머리 윗곡선은 내려가고 피부 턱은 올라갑니다. 같은 발선에서 넓은 흰 구간과 안경 아래 볼 높이가 동시에 줄어듭니다. 안경알의 정상적인 옆면 폭 감소와 별개로, 세로 압축이 보입니다.","action":"정면의 둥근 흰 머리와 안경 아래 턱을 기준으로 두 측면의 상하 부피를 함께 복구합니다. 안경·창의 좌우 가림은 유지합니다."}},"protectedText":"정면·후면과 양쪽 안경, 동공, 창, 몸을 보존했습니다. 양쪽 아래턱은 목깃에 맞춰 이어 그렸습니다.","evidence":"defense/docs/art/turnaround-20261120/README.md","formal":{"pass":11,"caution":6},"flags":{"before":5,"after":2},"formalPath":"defense/docs/art/turnaround-20261120/lightning_sage/formal-review.json"}},{"id":"time_magician","name":"시간의마술사","kind":"hero","parent":null,"rarity":"SR","hidden":false,"heightGroup":"medium","atlasKey":"unit-time_magician","foot":0.9375,"renderScale":1,"portrait":{"x":255,"y":207,"size":250},"sourcePath":"defense/assets/cast-turnaround-20261120/time_magician.webp","sourceHash":"852c463579a1a7721796a00d7839822a5368174c5cd1653ee343499d436b758a","sourceWidth":1024,"sourceBytes":448070,"sourceData":"@repo/defense/assets/cast-turnaround-20261120/time_magician.webp","gamePath":"defense/assets/optimized/cast-turnaround-20261120/time_magician.webp","gameHash":"b78d281aea0902efd8ffaf61e917d4363ed406f8dffb00af006992b61901edec","gameWidth":640,"gameBytes":194366,"gameData":"@repo/defense/assets/optimized/cast-turnaround-20261120/time_magician.webp","bounds":[[86,80,313,401],[115,81,297,400],[121,88,230,393],[131,87,238,394]],"gameBounds":[[84.80000000000001,80,315.20000000000005,401.6],[115.2,80,297.6,401.6],[120,88,232,393.6],[131.20000000000002,86.4,238.4,395.20000000000005]],"optics":{"sourceHash":"852c463579a1a7721796a00d7839822a5368174c5cd1653ee343499d436b758a","views":[{"box":[189,188,300,284],"eye":[242,239],"u":6,"note":"정면은 채택본을 보존했다. 녹색 두 동공의 중점이다. 갈색 둥근 윗선 위의 갈고리 가닥은 별도로 읽었다."},null,{"box":[183,202,248,284],"eye":[203,244],"u":6,"note":"기존 #672 채택 왼쪽. 볼과 피부 턱 하단은 유지했고 귀 위 뒷머리는 횡폭으로 제외했다."},{"box":[241,206,313,287],"eye":[292,248],"u":6,"note":"싹 위 갈고리가 아닌 뒤통수에 넓게 이어지는 갈색 윗선의 중앙이다. 가닥 최고점, 보이는 녹색 동공 한 개와 턱은 따로 읽었다."}]},"core":{"sourceHash":"852c463579a1a7721796a00d7839822a5368174c5cd1653ee343499d436b758a","views":[{"crown":[255,106],"chin":[240,284],"span":[138,346],"tip":[234,81],"kind":"hair","eye":[242,239],"u":[5,3],"note":"정면은 채택본을 보존했다. 녹색 두 동공의 중점이다. 갈색 둥근 윗선 위의 갈고리 가닥은 별도로 읽었다."},null,{"crown":[246,120],"chin":[206,284],"span":[151,328],"tip":[221,89],"kind":"hair","eye":[203,244],"u":[6,3],"note":"기존 #672 채택 왼쪽. 볼과 피부 턱 하단은 유지했고 귀 위 뒷머리는 횡폭으로 제외했다."},{"crown":[243,118],"chin":[290,288],"span":[150,339],"tip":[269,88],"kind":"hair","eye":[292,248],"u":[5,3],"note":"싹 위 갈고리가 아닌 뒤통수에 넓게 이어지는 갈색 윗선의 중앙이다. 가닥 최고점, 보이는 녹색 동공 한 개와 턱은 따로 읽었다."}],"decision":"review","side":"오른쪽","note":"오른쪽 윗머리와 갈고리 가닥을 교정했습니다. 오른쪽은 정면보다 8px, 기존 왼쪽은 14px 작습니다. 오른쪽 눈높이와 좁은 피부창은 기존 그림에서 이어집니다.","action":"오른쪽 교정본을 적용했습니다. #672의 왼쪽은 그대로 두고, 얼굴창·동공 높이 차이는 추가 대조로 표시합니다."},"measure":{"source":"defense/docs/art/turnaround-20261120/review.json","views":[{"skull":[255.35,206.65,159.56,150.41,-3],"chin":[255.35,281.85],"sole":[256,480],"eyes":[[213,245],[272,233]],"crownY":131.43,"shoulders":[250,320],"hips":[249,388],"anatomicalHeight":348.57,"belowChin":198.15,"skullUncertainty":11.77,"heightUncertainty":15.04},{"skull":[260.58,207.96,159.56,150.41,3],"chin":[260.58,283.16],"sole":[256,480],"eyes":[],"crownY":132.74,"shoulders":[256,320],"hips":[252,386],"anatomicalHeight":347.26,"belowChin":196.84,"skullUncertainty":17,"heightUncertainty":20.27},{"skull":[249,208,148,148,-2],"chin":[211,283],"sole":[256,480],"eyes":[[201,244]],"crownY":134,"shoulders":[243,315],"hips":[238,391],"anatomicalHeight":346,"belowChin":197,"skullUncertainty":12,"heightUncertainty":null},{"skull":[255,212,150,147,0],"chin":[290,288],"sole":[256,480],"eyes":[[292,248]],"shoulders"