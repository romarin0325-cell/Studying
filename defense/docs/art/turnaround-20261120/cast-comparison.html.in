sets/merge/units/queen.webp"},{"id":"ref_snow_rabbit","name":"눈토끼","kind":"reference","version":"#561","sourcePath":"defense/assets/merge/units/snow_rabbit.webp","sourceCommit":"5c7c3676e716005673d7c478f0e4b084abd9a60a","sourceHash":"339d4a04a2d1403d81808875397758987d56646567ba622bdbba686a6fd4e393","sourceWidth":1024,"sourceData":"@repo/defense/assets/merge/units/snow_rabbit.webp"},{"id":"ref_cherry_prince","name":"체리프린스","kind":"reference","version":"#561","sourcePath":"defense/assets/merge/units/cherry_prince.webp","sourceCommit":"5c7c3676e716005673d7c478f0e4b084abd9a60a","sourceHash":"f4e630745f887a1507b4f7a9f8d3a468e6fb758868a98a721a0c64a014259252","sourceWidth":1024,"sourceData":"@repo/defense/assets/merge/units/cherry_prince.webp"},{"id":"ref_jasmine","name":"자스민","kind":"reference","version":"#561","sourcePath":"defense/assets/merge/units/jasmine.webp","sourceCommit":"5c7c3676e716005673d7c478f0e4b084abd9a60a","sourceHash":"8761aff39dbe4b90a3674a5dec0f4753c00087bb6e9c081f61bae4e081feda2a","sourceWidth":1024,"sourceData":"@repo/defense/assets/merge/units/jasmine.webp"}],"octSiren":{"id":"oct_siren","name":"세이렌","kind":"reference","version":"#629","sourcePath":"defense/assets/cast-v2/siren.webp","sourceCommit":"85203be1388cd5a8353817a91d252d882ace8398","sourceHash":"60b2c0380af708dc5d74e4a21bd7ba12b0574d7047a13d08669c18d28f750b3c","sourceWidth":1024,"sourceData":"@repo/defense/assets/cast-v2/siren.webp"},"previousCommit":"3379bc5e9a5edf40d87a00e3be8ca207ca866185"}</script><script>/* Geometry shared by the evidence report and the offline roster viewer.
   Marks are picked on the picture in canonical 512-cell coordinates. */
(function (root, build) {
  const api = build();
  if (typeof module === 'object' && module.exports) module.exports = api;
  else root.SDHeadAudit = api;
})(typeof globalThis === 'object' ? globalThis : this, function () {
  'use strict';
  const coordinate = value => Number.isFinite(value) && value >= 0 && value <= 512;
  const point = p => Array.isArray(p) && p.length === 2 && p.every(coordinate);
  const diff = (a, b) => Number.isFinite(a) && Number.isFinite(b) ? a - b : null;
  function validate(v) {
    if (!v || typeof v !== 'object') throw Error('Expected a view object');
    for (const k of ['crown', 'chin', 'span', 'tip']) {
      if (v[k] !== null && !point(v[k])) throw Error('Invalid or absent ' + k);
    }
    if (v.eye != null && !point(v.eye)) throw Error('Invalid eye');
    if (!['hair','gear','ear','none'].includes(v.kind)) throw Error('Invalid tip kind');
    if ((v.tip === null) !== (v.kind === 'none')) throw Error('Link a tip to its kind');
    if (v.span && v.span[1] <= v.span[0]) throw Error('Span must be left-to-right');
    if (v.crown && v.chin && v.crown[1] >= v.chin[1]) throw Error('Crown must be above chin');
    if (!Array.isArray(v.u) || v.u.length !== 2 ||
        !v.u.every(n => Number.isFinite(n) && n >= 0 && n <= 256)) throw Error('Invalid crown/chin uncertainty');
  }
  function measure(v, eye) {
    if (!v) return {};
    const c = v.crown?.[1], j = v.chin?.[1], e = (eye ?? v.eye)?.[1];
    const h = diff(j,c), w = v.span ? diff(v.span[1],v.span[0]) : null;
    const u = v.u || [];
    return {height:h, center:h == null ? null : (j+c)/2, width:w, crown:c ?? null, chin:j ?? null,
      eye:e ?? null, tip:v.tip?.[1] ?? null, lowerFace:diff(j,e), extension:diff(c,v.tip?.[1]),
      heightU:h == null ? null : u[0]+u[1], centerU:h == null ? null : (u[0]+u[1])/2};
  }
  function pair(front, side) {
    const result = {};
    for (const k of ['height','center','width','crown','chin','eye','lowerFace','extension']) result[k]=diff(side[k],front[k]);
    result.tipAgainstFront=diff(side.tip,front.crown);
    result.heightPct = front.height > 0 && result.height != null ? 100 * result.height / front.height : null;
    result.heightBand = Number.isFinite(front.heightU) && Number.isFinite(side.heightU) ? front.heightU+side.heightU : null;
    result.centerBand = Number.isFinite(front.centerU) && Number.isFinite(side.centerU) ? front.centerU+side.centerU : null;
    return result;
  }
  return {validate,measure,pair};
});

function renderReleaseRow(a){
 const root=$('coreRelease');if(!root)return;const changed=a.revision;
 root.hidden=!changed;$('releasePriorPics').replaceChildren();$('releaseCurrentLabel').hidden=true;
 if(!changed)return;
 const old=changed.previous,ds=[0,2,3],heights=x=>ds.map(d=>fmt(readCore(x,d).height)).join(' / ');
 $('releaseSummary').textContent='실효 머리 정·좌·우 '+heights(old)+' → '+heights(a)+'px';
 $('releaseEvidence').textContent=changed.protectedText;
 if(!$('showOldViews').checked)return;
 const fragment=document.createDocumentFragment();
 for(const d of ds){const frame=el('figure','core-frame old-frame'),label=el('figcaption','core-direc','수정 전 · '+dirNames[d]);label.append(el('b','',fmt(readCore(old,d).height)+'px'));frame.append(coreDrawing(old,d),label);fragment.append(frame);}
 $('releasePriorPics').append(fragment);$('releaseCurrentLabel').hidden=false;
}
function stableOlderRecords(input){
 if(!input||typeof input!=='object'||Array.isArray(input))throw Error('검토 기록 형식이 맞지 않습니다.');
 const preserved=Object.create(null);
 for(const a of actors)if(Object.hasOwn(input,a.id)&&input[a.id]?.atlas===a.sourceHash)preserved[a.id]=input[a.id];
 return cleanImport(preserved);
}


'use strict';
const $ = id => document.getElementById(id);
const D = JSON.parse($('payload').textContent);
const actors = D.actors;
const byId = new Map([...actors,...D.references,D.octSiren].map(a=>[a.id,a]));
const dirNames = ['정면','후면','왼쪽','오른쪽'];
const groupNames = {short:'작은 키',medium:'보통 키',tall:'큰 키',unknown:'미지정'};
const groupRank = {short:0,medium:1,tall:2,unknown:3};
const grounds = {slate:['회청색','#43505e'],dark:['어두운 바닥','#24303c'],light:['밝은 바닥','#ebe7dc']};
const axisInfo = [
 ['head','머리·얼굴','동료 옆에서 눈·볼·턱과 체감 얼굴 크기'],
 ['height','키·체형','의도한 키군, 몸통·다리와 서 있는 자세'],
 ['direction','네 방향·장비','회전할 때 얼굴·몸의 부피, 소품 손과 가림'],
 ['line','그림체·선','눈매, 윤곽선·내부선의 굵기와 단순화'],
 ['paint','명암·색·디테일','광원, 그림자 경계, 소재별 하이라이트 밀도']
];
const statuses = Object.freeze({pending:'미검토',pass:'적합',revisit:'재검토'});
const state={dir:0,bg:'slate',tone:'color',quality:'game',guide:false,rosterView:'one',thumb:64,query:'',group:'all',filter:'all',order:'game',pins:['siren','luna','cherry_prince'].filter(x=>byId.has(x)),mode:'one',crop:'both',size:window.innerWidth>=1100?208:160,ref:'',mix:50,a:'',b:'',analysis:'height',tolerance:8,strict:false,showAll:false,who:'siren'};
const key='sg.cast.review.v1.'+D.commit;
let records=Object.create(null),storageWorks=true, timer=null,noticeTimer=null;
const cache=new Map();
function el(tag,cls='',content=''){const n=document.createElement(tag);if(cls)n.className=cls;if(content!=='')n.textContent=content;return n;}
function btn(label,fn,cls='btn'){const n=el('button',cls,label);n.type='button';n.addEventListener('click',fn);return n;}
function opts(sel,items,value){sel.replaceChildren(...items.map(([v,t])=>new Option(t,v)));if(value!=null)sel.value=value;}
function segmented(box,items,selected,handler){
 box.replaceChildren(...items.map(([v,label])=>{const b=btn(label,()=>handler(v),'');b.dataset.value=v;b.setAttribute('aria-pressed',String(v===selected));return b;}));
}
function updatePressed(box,value){for(const b of box.querySelectorAll('button[data-value]'))b.setAttribute('aria-pressed',String(b.dataset.value===String(value)));}
function fmt(n,digits=1){return Number.isFinite(n)?n.toFixed(digits).replace(/\.0$/,''):'—';}
function med(arr){const s=arr.filter(Number.isFinite).sort((a,b)=>a-b);if(!s.length)return null;const mid=Math.floor(s.length/2);return s.length%2?s[mid]:(s[mid]+s[mid-1])/2;}
function showNotice(message){$('notice').textContent=message;$('notice').style.display='block';clearTimeout(noticeTimer);noticeTimer=setTimeout(()=>{$('notice').style.display='none';},2600);}
function cleanImport(value){const clean=Object.create(null);if(!value||typeof value!=='object'||Array.isArray(value))throw Error('판정 기록 형식이 맞지 않습니다.');
 for(const a of actors){const r=value[a.id];if(!r)continue;if(r.atlas!==a.sourceHash||!r.axes||typeof r.axes!=='object')throw Error(a.name+'의 그림 또는 항목 형식이 다릅니다.');
 const axes={};for(const [id] of axisInfo){const v=r.axes[id]??'pending';if(!Object.hasOwn(statuses,v))throw Error('알 수 없는 판정입니다.');axes[id]=v;}
 clean[a.id]={atlas:a.sourceHash,axes,note:typeof r.note==='string'?r.note.slice(0,5000):''};
 }return clean;}
try{const saved=localStorage.getItem(key);
 if(saved)records=cleanImport(JSON.parse(saved));
 else if(D.previousCommit){const old=localStorage.getItem('sg.cast.review.v1.'+D.previousCommit);if(old)records=stableOlderRecords(JSON.parse(old));}
}catch{storageWorks=false;}
function save(){try{localStorage.setItem(key,JSON.stringify(records));storageWorks=true;}catch{storageWorks=false;}saveLabel();}
function saveLabel(){ $('saving').textContent=storageWorks?'이 브라우저에 저장 · 다른 기기에서는 JSON으로 이동':'브라우저 저장 제한 · 기록 내보내기로 보관하세요';}
function reviewFor(a){return records[a.id]||{atlas:a.sourceHash,axes:{},note:''};}
function verdict(a){const ax=reviewFor(a).axes;return axisInfo.some(([k])=>ax[k]==='revisit')?'revisit':axisInfo.every(([k])=>ax[k]==='pass')?'pass':'pending';}
function imgFor(a,quality){const field=quality==='game'&&a.gameData?'gameData':'sourceData',id=a.id+'|'+field;if(cache.has(id))return cache.get(id);
 const im=new Image();const result=new Promise((resolve,reject)=>{im.onload=()=>resolve(im);im.onerror=()=>reject(Error('이미지를 읽을 수 없습니다. '+a.name));});im.src=a[field];cache.set(id,result);return result;}
function measure(a,d){return a.measure?.views[d]||{};}
function bounds(a,d){return (state.quality==='game'?a.gameBounds:a.bounds)?.[d]||null;}
function groupOf(a){return a.measure?.heightClass||'unknown';}
function spread(a){const sizes=a.measure?.views.map(v=>v.anatomicalHeight);if(!sizes||sizes.some(v=>!Number.isFinite(v)))return null;const low=Math.min(...sizes),high=Math.max(...sizes);return {diff:high-low,lo:sizes.indexOf(low),hi:sizes.indexOf(high)};}
const faceWindow=[112,72,288,288],clothWindow=[136,240,240,240],fullWindow=[0,0,512,512];
function drawGuides(ctx,a,d,w,size){const m=measure(a,d),unit=w[2]/size;ctx.save();ctx.lineWidth=1.1*unit;ctx.shadowColor='#10212b';ctx.shadowBlur=1.4*unit;
 ctx.setLineDash([4*unit,3*unit]);ctx.strokeStyle='#9ef2d9';ctx.beginPath();ctx.moveTo(w[0],480);ctx.lineTo(w[0]+w[2],480);ctx.stroke();ctx.setLineDash([]);
 if(m.skull){const [x,y,sw,sh,roll]=m.skull;ctx.beginPath();ctx.ellipse(x,y,sw/2,sh/2,roll*Math.PI/180,0,2*Math.PI);ctx.strokeStyle='#8ff1d1';ctx.stroke();}
 if(m.chin){ctx.fillStyle='#ffbf75';ctx.beginPath();ctx.arc(m.chin[0],m.chin[1],2.4*unit,0,Math.PI*2);ctx.fill();}
 for(const eye of (m.eyes||[])){ctx.beginPath();ctx.arc(eye[0],eye[1],1.9*unit,0,Math.PI*2);ctx.fillStyle='#fbf5ab';ctx.fill();}
 ctx.restore();
}
function sprite(a,d,size,settings={}){
 const c=el('canvas','pic');const res=Math.max(1,Math.min(2,window.devicePixelRatio||1));c.width=c.height=Math.round(size*res);c.style.width=c.style.height=size+'px';c.setAttribute('role','img');c.setAttribute('aria-label',a.name+' '+dirNames[d]+(settings.mirror?' 반전':''));
 const crop=settings.crop??state.crop,w=crop==='face'?faceWindow:crop==='cloth'?clothWindow:fullWindow, tone=settings.tone??state.tone,guide=settings.guide??state.guide,quality=settings.quality??state.quality,background=grounds[state.bg][1];
 imgFor(a,quality).then(im=>{const ctx=c.getContext('2d'),unit=c.width/w[2],cell=im.naturalWidth/2;ctx.imageSmoothingQuality='high';ctx.save();
 if(settings.mirror){ctx.translate(c.width,0);ctx.scale(-1,1);}ctx.filter=tone==='gray'?'grayscale(1)':'none';
 ctx.drawImage(im,(d%2)*cell+w[0]*cell/512,Math.floor(d/2)*cell+w[1]*cell/512,w[2]*cell/512,w[3]*cell/512,0,0,c.width,c.height);ctx.filter='none';
 if(tone==='solid'){ctx.globalCompositeOperation='source-in';ctx.fillStyle=background===grounds.light[1]?'#253247':'#f0f5f2';ctx.fillRect(0,0,c.width,c.height);ctx.globalCompositeOperation='source-over';}
 if(guide||state.faceGuide){ctx.scale(unit,unit);ctx.translate(-w[0],-w[1]);if(guide)drawGuides(ctx,a,d,w,size);if(state.faceGuide)opticalGuides(ctx,a,d,w,size);}ctx.restore();c.dataset.drawn='1';
 }).catch(e=>{c.dataset.error='1';showNotice(e.message);});return c;
}
function selectActors(){return state.pins.map(id=>byId.get(id)).filter(Boolean);}
function togglePin(id,focus=false){const idx=state.pins.indexOf(id);if(idx<0){state.pins.push(id);state.who=id;}else state.pins.splice(idx,1);
 renderSelection();if(focus)document.querySelector('[data-pick="'+id+'"]')?.focus({preventScroll:true});}
function renderProgress(){const good=actors.filter(a=>verdict(a)==='pass').length,bad=actors.filter(a=>verdict(a)==='revisit').length;
 $('progressText').textContent='적합 '+good+' · 재검토 '+bad+' · 미완료 '+(actors.length-good-bad);
 $('progressFill').style.width=(good/actors.length*100)+'%';$('doneSummary').textContent='캐릭터 전체 적합 '+good+' / '+actors.length;
}
function renderRoster(){const list=actors.filter(a=>{
 const v=verdict(a),q=state.query.trim().toLocaleLowerCase().replace(/\s/g,'');
 return (!q||(a.name+a.id).toLocaleLowerCase().replace(/\s/g,'').includes(q))&&(state.group==='all'||groupOf(a)===state.group)&&(state.filter==='all'||(state.filter==='forms'?a.kind==='form':v===state.filter));
 });
 if(state.order==='name')list.sort((a,b)=>a.name.localeCompare(b.name,'ko'));if(state.order==='group')list.sort((a,b)=>groupRank[groupOf(a)]-groupRank[groupOf(b)]);
 if(state.order==='height')list.sort((a,b)=>(measure(b,0).anatomicalHeight??-1)-(measure(a,0).anatomicalHeight??-1));
 if(state.order==='head')list.sort((a,b)=>{const area=a=>{const v=measure(a,state.dir).skull;return v?v[2]*v[3]:-1;};return area(b)-area(a);});
 if(state.order==='drift')list.sort((a,b)=>(spread(b)?.diff??-1)-(spread(a)?.diff??-1));
 const grid=$('grid'),allViews=state.rosterView==='all',fragment=document.createDocumentFragment();grid.classList.toggle('directionslist',allViews);grid.style.setProperty('--small',state.thumb+'px');
 $('matchCount').textContent=list.length+' / '+actors.length+'종 · 눌러서 선택';
 if(allViews&&list.length){const cap=el('div','rosterline cap');cap.append(el('span','','이름'),...dirNames.map(n=>el('span','',n)));fragment.append(cap);}
 for(const a of list){const pinned=state.pins.includes(a.id),v=verdict(a);
 const b=btn('',e=>togglePin(a.id,e.detail===0),allViews?'tile rosterline':'tile');b.dataset.pick=a.id;b.setAttribute('aria-pressed',String(pinned));b.setAttribute('aria-label',a.name+' '+(pinned?'선택 해제':'비교에 추가'));b.title=a.name+' · '+groupNames[groupOf(a)]+' · '+(v==='pending'?'미완료':statuses[v]);
 const label=el('span','tilelabel',a.name);
 if(allViews){b.append(label,...dirNames.map((_,d)=>sprite(a,d,state.thumb,{crop:'full'})));}else{b.append(sprite(a,state.dir,state.thumb,{crop:'full'}),label);}
 if(pinned){const mark=el('span','pinmark','✓');mark.setAttribute('aria-hidden','true');b.append(mark);}
 if(v!=='pending'){const mark=el('span','statusmark '+(v==='pass'?'ok':''),v==='pass'?'적합':'재검토');b.append(mark);}
 fragment.append(b);}
 if(!list.length)fragment.append(el('p','empty','조건에 맞는 캐릭터가 없습니다. 이름이나 필터를 바꿔 보세요.'));grid.replaceChildren(fragment);
 if(lineState.scope==='filtered')renderLineup();if(rankState.scope==='filtered')renderRanking();
}
function renderPins(){const arr=selectActors();$('pinCount').textContent=arr.length;$('clearPins').disabled=arr.length===0;
 $('pins').replaceChildren(...arr.map(a=>{const b=btn(a.name,()=>togglePin(a.id),'pin');b.setAttribute('aria-label',a.name+' 선택 해제');b.append(el('span','','×'));return b;}));$('mobileCount').textContent='선택 비교 '+arr.length;
 $('mobilepins').replaceChildren(...arr.slice(0,3).map(a=>sprite(a,state.dir,34,{crop:'full',guide:false})));
}
function overlay(a,d,b,e,size,flip=false,crop='full'){const stack=el('div','canvasstack');stack.style.width=stack.style.height=size+'px';const back=sprite(a,d,size,{crop}),top=sprite(b,e,size,{crop,mirror:flip});
 top.classList.add('ghost');top.style.background=grounds[state.bg][1];top.style.opacity=state.mix/100;stack.append(back,top);return stack;}
function renderStage(){const arr=selectActors();if(state.ref)arr.push(byId.get(state.ref));const stage=$('stage'),grid=el('div','sgrid');stage.replaceChildren();
 const blend=state.mode==='overlay'||state.mode==='mirror',o=state.mode==='overlay';$('blendControls').hidden=!blend;$('aSelect').hidden=!o;$('bSelect').hidden=!o;$('blendValue').textContent=state.mix+'%';$('blendLabel').textContent=state.mode==='mirror'?'반전한 오른쪽':'B 표시';$('blend').value=state.mix;
 updatePressed($('modes'),state.mode);$('openRuler').disabled=!actors.length;
 if(!arr.length){stage.append(el('p','empty','전체판에서 비교할 캐릭터를 누르세요.'));$('stageNote').textContent='선택한 캐릭터는 전체판을 검색하거나 필터링해도 유지됩니다.';return;}
 const names=a=>a.kind==='reference'?a.version+' '+a.name:a.name;
 const crops=state.crop==='both'?['full','face']:[state.crop];
 if(o){if(!arr.some(a=>a.id===state.a))state.a=arr[0].id;if(!arr.some(a=>a.id===state.b)||state.b===state.a)state.b=(arr.find(a=>a.id!==state.a)||arr[0]).id;
 opts($('overlayA'),arr.map(a=>[a.id,names(a)]),state.a);opts($('overlayB'),arr.filter(a=>a.id!==state.a).map(a=>[a.id,names(a)]),state.b);
 if(arr.length<2){stage.append(el('p','empty','겹쳐 볼 캐릭터를 두 명 선택하거나 화풍 기준을 한 장 추가하세요.'));$('stageNote').textContent='두 그림은 같은 방향과 발 기준으로 겹칩니다.';return;}
 const a=byId.get(state.a),b=byId.get(state.b);grid.style.gridTemplateColumns='26px '+state.size+'px';grid.append(el('div','colhead'),el('div','colhead','A '+names(a)+'  /  B '+names(b)+' · '+dirNames[state.dir]));
 for(const crop of crops){grid.append(el('div','rowlab',crop==='face'?'얼굴':crop==='cloth'?'옷·선':'전신'));const cell=el('div','cell');cell.append(overlay(a,state.dir,b,state.dir,state.size,false,crop));grid.append(cell);}
 }else{const four=state.mode==='four',mirror=state.mode==='mirror';
 const rowLabel=four||crops.length>1;
 grid.style.gridTemplateColumns=(rowLabel?'26px ':'')+'repeat('+arr.length+', '+state.size+'px)';
 if(rowLabel)grid.append(el('div','colhead'));for(const a of arr)grid.append(el('div','colhead '+(a.kind==='reference'?'ref':''),names(a)));
 const ds=four?[0,1,2,3]:[state.dir];for(const d of ds){for(const crop of crops){if(rowLabel)grid.append(el('div','rowlab',(four?dirNames[d]+' ':'')+(crops.length>1?(crop==='face'?'얼굴':'전신'):'')));for(const a of arr){const cell=el('div','cell');cell.append(mirror?overlay(a,2,a,3,state.size,true,crop):sprite(a,d,state.size,{crop}));grid.append(cell);}}}
 }
 stage.append(grid);
 const desc={one:dirNames[state.dir]+' · 같은 크기로 나란히 표시',four:'각 행은 같은 방향이며, 네 행에서 발선과 얼굴·몸의 변화가 보입니다.',overlay:'0%는 A, 100%는 B입니다. 같은 셀 좌표에서 비교합니다.',mirror:'왼쪽 위에 좌우 반전한 오른쪽을 겹칩니다. 장비 위치와 조명에는 의도된 비대칭이 있을 수 있습니다.'};
 $('stageNote').textContent=desc[state.mode]+(state.crop==='cloth'?' · 옷과 내부선은 (136,240)부터 240×240px':state.crop!=='full'?' · 모든 얼굴창은 (112,72)부터 288×288px':'')+(state.guide?' · 민트색 두개부 추정선과 발 기준, 주황색 턱':'')+(state.faceGuide?' · 분홍색은 실효 얼굴, 금색은 보이는 동공 중심':'')+(state.ref?' · #561 기준은 당시 보관본':'')+(stage.scrollWidth>stage.clientWidth+1?' · 좌우로 스크롤해 전체 선택 보기':'');
}
function renderSelection(){renderRoster();renderPins();renderStage();renderMetrics();renderReview();renderLineup();renderRanking();}
function refreshImages(){renderCorePics();renderCoreMini();document.documentElement.style.setProperty('--floor',grounds[state.bg][1]);renderRoster();renderPins();renderStage();renderMetrics();renderReviewArt();renderLineup();renderRanking();if(state.analysis==='head')renderFindings();if($('rulerDialog').open)paintRuler();}
function setDir(d){state.dir=d;lineState.dir=d;rankState.dir=d;$('lineDir').value=d;$('rankDir').value=d;updatePressed($('dirs'),d);refreshImages();}
function stopTurn(){if(timer){clearInterval(timer);timer=null;}$('turn').textContent='회전 재생';$('turn').setAttribute('aria-pressed','false');}
function currentFields(m){return m.skull?fmt(m.skull[2])+' × '+fmt(m.skull[3]):'—';}
function renderMetrics(){const arr=selectActors(),directions=state.mode==='four'?[0,1,2,3]:state.mode==='mirror'?[2,3]:[state.dir];const out=$('metricsTable');out.replaceChildren();
 if($('measureKind').value==='face'){renderFaceMetrics(arr,directions);return;}
 $('metricDesc').textContent='512px 셀 좌표 · 정수리와 두개부는 장식과 머리카락을 제외한 제작 추정';
 if(!arr.length){out.append(el('p','hint','선택한 캐릭터의 자료가 여기에 표시됩니다.'));$('measureNote').textContent='';return;}
 const tab=el('table','metricstable');const head=tab.createTHead().insertRow();
 for(const s of ['캐릭터','방향','키군','두개부 폭×높이','정수리~발','참고폭 ±','턱~발','눈~턱¹','전신 외곽 높이'])head.append(el('th','',s));
 const tbody=tab.createTBody();for(const a of arr){for(const d of directions){const m=measure(a,d),v=bounds(a,d);const eyes=(m.eyes||[]).filter(p=>Number.isFinite(p[1]));const eyeDistance=eyes.length&&m.chin?m.chin[1]-eyes.reduce((s,p)=>s+p[1],0)/eyes.length:null;
 const row=tbody.insertRow();for(const t of [a.name,dirNames[d],groupNames[groupOf(a)],currentFields(m),fmt(m.anatomicalHeight),fmt(m.heightUncertainty),fmt(m.belowChin),fmt(eyeDistance),fmt(v?.[3])])row.append(el('td','',t));}}
 out.append(tab);$('measureNote').textContent='¹ 제작 당시 기록한 눈의 평균 높이부터 턱까지. —는 해당 기록 없음. 이번에 읽은 눈 위치는 실효 얼굴·눈에서 볼 수 있습니다. 외곽은 장식 포함 알파 ≥32입니다. '+arr.filter(a=>a.measure.note).map(a=>a.name+' · '+a.measure.note).join(' ');
}


const lineState={scope:'all',dir:0,order:'group',zoom:'96',ref:'siren',feature:'crown',height:340,size:96,lines:[]};
const rankState={metric:'coreHeightDelta',scope:'all',order:'desc',dir:0};
const rankMetrics={
 coreHeightDelta:['정면↔측면 · 실효 머리 높이 차이','본체 윗선~턱','px','짧은 머리 다발이 이루는 넓은 호에서 실제 턱까지의 높이입니다. 머리 윗선·턱이 가려지면 측정값을 비워 둡니다.'],
 coreCenterDelta:['정면↔측면 · 실효 머리 중심 이동','실효 머리 중심 Y','px','공통 발선에서 본체 윗선과 턱의 중간 Y를 비교합니다. 양수는 측면에서 아래로 이동한 것입니다.'],
 bodyDelta:['정면↔측면 · 제작 기록의 추정 키 차이','정수리~발 투영 높이','px','두 측면 중 정면과의 절대차가 큰 값을 기준으로 정렬합니다. 머리카락·장비는 제외합니다.'],
 outerDelta:['정면↔측면 · 전신 외곽 높이 차이','알파 외곽 높이','px','현재 선택한 이미지에서 알파 32 이상인 전신의 높이입니다. 뿔·모자·무기를 포함합니다.'],
 faceYDelta:['정면↔측면 · 얼굴 중심 높이 차이','실효 얼굴 중심 Y','px','공통 발선에 맞춘 셀에서 얼굴창 중심의 세로 위치를 잽니다. Y가 클수록 화면 아래입니다.'],
 eyeYDelta:['정면↔측면 · 눈높이 차이','보이는 눈 중심 Y','px','정면은 보이는 동공들의 중점, 측면은 보이는 동공의 중심입니다. 가려진 눈은 추정하지 않습니다.'],
 faceXDelta:['정면↔측면 · 얼굴 중심 가로 차이','실효 얼굴 중심 X','px','같은 셀의 가로 위치 차이입니다. 얼굴 방향·자세가 의도한 이동도 함께 표시됩니다.'],
 faceHeightDelta:['정면↔측면 · 실효 얼굴 높이 차이','실효 얼굴창 높이','px','얼굴 피부와 눈·코·턱으로 읽히는 창의 높이를 비교합니다. 앞머리·마스크에 의한 가림이 반영됩니다.'],
 faceWidth:['실효 얼굴 · 폭','실효 얼굴창 폭','px','선택한 방향에서 드러난 얼굴 너비를 정렬합니다. 귀·머리카락·뿔·모자는 제외합니다.'],
 faceHeight:['실효 얼굴 · 높이','실효 얼굴창 높이','px','같은 정수리 높이에서도 드러난 이마·볼·턱의 정도가 어떻게 다른지 보세요.'],
 faceScale:['실효 얼굴 · 크기','얼굴창 등가 길이','px','얼굴창 폭×높이의 제곱근입니다. 보이는 얼굴의 범위를 나타내는 길이 지표이며, 실제 피부 면적은 별도로 셈하지 않습니다.'],
 faceAspect:['실효 얼굴 · 가로/세로','얼굴창 가로/세로','배','같은 방향에서 볼·턱이 넓거나 세로로 눌려 보이는 후보를 찾습니다. 고개 각도와 의도된 비대칭을 함께 보세요.'],
 faceBody:['실효 얼굴 · 키 대비 비율','얼굴 높이/추정 키','%','실효 얼굴창 높이를 같은 방향 정수리~발 투영 높이로 나눕니다.'],
 faceSkull:['실효 얼굴 · 두개부 대비 비율','얼굴 높이/두개부 높이','%','실효 얼굴창 높이를 같은 방향의 두개부 회전 타원 높이(축 길이)로 나눕니다.']
};
function optics(a,d){const v=a.optics?.views?.[d];if(!v)return {};
 const box=v.box,eye=v.eye;if(!box)return {eye,u:v.u,note:v.note};
 const [left,top,right,bottom]=box;return {box,eye,u:v.u,note:v.note,width:right-left,height:bottom-top,x:(left+right)/2,y:(top+bottom)/2};}
function opticalGuides(ctx,a,d,w,size){
 const m=optics(a,d),unit=w[2]/size;ctx.save();ctx.lineWidth=1.3*unit;ctx.strokeStyle='#ffb2d5';ctx.shadowColor='#38212e';ctx.shadowBlur=unit;
 if(m.box){ctx.setLineDash([4*unit,2*unit]);ctx.strokeRect(m.box[0],m.box[1],m.width,m.height);ctx.setLineDash([]);ctx.beginPath();ctx.moveTo(m.x-3*unit,m.y);ctx.lineTo(m.x+3*unit,m.y);ctx.moveTo(m.x,m.y-3*unit);ctx.lineTo(m.x,m.y+3*unit);ctx.stroke();}
 if(m.eye){ctx.fillStyle='#ffe177';ctx.beginPath();ctx.arc(m.eye[0],m.eye[1],2.2*unit,0,2*Math.PI);ctx.fill();}ctx.restore();
}
function scoped(scope){if(scope==='pins')return selectActors();if(scope==='filtered')return [...$('grid').querySelectorAll('[data-pick]')].map(b=>byId.get(b.dataset.pick));return [...actors];}
function lineupList(){
 const list=scoped(lineState.scope),d=lineState.dir;
 if(lineState.order==='group')list.sort((a,b)=>groupRank[groupOf(a)]-groupRank[groupOf(b)]||(measure(a,d).anatomicalHeight??Infinity)-(measure(b,d).anatomicalHeight??Infinity));
 if(lineState.order==='height')list.sort((a,b)=>(measure(a,d).anatomicalHeight??Infinity)-(measure(b,d).anatomicalHeight??Infinity));
 if(lineState.order==='face')list.sort((a,b)=>(optics(a,d).height??Infinity)-(optics(b,d).height??Infinity));
 return list;
}
function linePoint(){const a=byId.get(lineState.ref);if(!a)return null;const d=lineState.dir,m=measure(a,d);
 return lineState.feature==='manual'?480-lineState.height:lineState.feature==='crown'?m.crownY:lineState.feature==='eye'?optics(a,d).eye?.[1]:m.chin?.[1];}
function drawLineMarks(){
 const band=$('lineBandCursor'),axis=$('lineAxis');if(!band)return;
 const y=linePoint(),good=Number.isFinite(y),a=byId.get(lineState.ref),s=lineState.size;
 const title={crown:'정수리',eye:'눈높이',chin:'턱',manual:'직접 그은 선'}[lineState.feature];
 band.hidden=!good;$('freezeLine').disabled=!good;if(good){band.style.top=(y/512*s)+'px';$('lineHeight').value=String(Math.round(480-y));}
 $('lineReadout').textContent=good?(lineState.feature==='manual'?title:a.name+' '+title)+' · 발선에서 '+fmt(480-y)+'px':a.name+' · 이 방향에는 '+title+' 기록이 없습니다.';
 axis.replaceChildren();axis.style.height=s+'px';
 const mark=(cls,text,y)=>{const v=el('span','axislabel '+cls,text);v.style.top=(y/512*s)+'px';axis.append(v);};
 if(s>=52){mark('base','발',480);if(good)mark('ref','기준',y);}
 for(const existing of band.parentElement.querySelectorAll('.fixedLine'))existing.remove();
 const chips=$('frozenLines');chips.replaceChildren();for(const item of lineState.lines){
  const fixed=el('i','lineBand fixedLine');fixed.style.top=(item.y/512*s)+'px';fixed.style.borderColor=item.color;band.parentElement.insertBefore(fixed,band);
  const chip=btn(item.label+' · '+fmt(480-item.y)+'px ×',()=>{lineState.lines=lineState.lines.filter(l=>l!==item);drawLineMarks();},'linechip');
  chip.style.borderColor=item.color;chip.setAttribute('aria-label',item.label+' 기준선 삭제');chips.append(chip);}
}
function setLineRef(id,scroll=false,user=true){lineState.ref=id;$('lineRef').value=id;if(user&&lineState.feature==='manual'){lineState.feature='crown';$('lineFeature').value='crown';}
 const row=$('lineStrip');for(const b of row.querySelectorAll('[data-line-ref]')){const is=b.dataset.lineRef===id;b.classList.toggle('selected',is);b.setAttribute('aria-pressed',String(is));}
 for(const m of $('lineMap').children)m.setAttribute('aria-pressed',String(m.dataset.id===id));
 drawLineMarks();if(scroll){const b=row.querySelector('.lineAtlas [data-line-ref="'+id+'"]'),w=$('lineWindow');if(b)w.scrollLeft=b.offsetLeft-w.clientWidth/2+b.offsetWidth/2;}
}
function renderLineup(){const list=lineupList(),win=$('lineWindow'),area=$('lineStrip'),map=$('lineMap');
 if(!list.length){area.replaceChildren(el('p','empty','이 범위에 캐릭터가 없습니다. 전체를 선택하거나 비교할 캐릭터를 추가하세요.'));area.style.width='auto';map.replaceChildren();$('lineAxis').replaceChildren();$('frozenLines').replaceChildren();$('freezeLine').disabled=true;$('lineReadout').textContent='';$('lineHint').textContent='';$('lineRef').replaceChildren();return;}
 const oldScroll=win.scrollLeft;if(!list.some(a=>a.id===lineState.ref))lineState.ref=list[0].id;
 opts($('lineRef'),list.map(a=>[a.id,'기준 · '+a.name]),lineState.ref);
 const s=lineState.zoom==='fit'?Math.max(4,Math.floor((win.clientWidth-2)/list.length)):Number(lineState.zoom);lineState.size=Math.min(256,s);const size=lineState.size;
 const strip=el('div','lineAtlas'),names=el('div','lineNames'+(lineState.zoom==='fit'?' fitNames':''));strip.style.height=size+'px';strip.style.width=names.style.width=(size*list.length)+'px';
 const chart=document.createDocumentFragment();const heights=list.map(a=>measure(a,lineState.dir).anatomicalHeight).filter(Number.isFinite);
 const lo=Math.min(...heights),hi=Math.max(...heights);
 for(const [i,a] of list.entries()){
 const click=()=>setLineRef(a.id);const b=btn('',click,''),name=btn(size<36?String(i+1):a.name,click,'');
 for(const n of [b,name]){n.dataset.lineRef=a.id;n.setAttribute('aria-label',a.name+' 기준선으로 선택');n.style.width=size+'px';n.title=a.name+' · '+groupNames[groupOf(a)]+' · 정수리~발 '+fmt(measure(a,lineState.dir).anatomicalHeight)+'px';}
 b.append(sprite(a,lineState.dir,size,{crop:'full'}));strip.append(b);names.append(name);
 const bar=btn('',()=>setLineRef(a.id,true),'mapmark'),barInk=el('i');const h=measure(a,lineState.dir).anatomicalHeight;bar.dataset.height=groupOf(a);bar.dataset.id=a.id;bar.setAttribute('aria-label',a.name+' 줄 위치로 이동');bar.title=b.title;barInk.style.height=(Number.isFinite(h)?6+(h-lo)/Math.max(hi-lo,1)*24:2)+'px';bar.append(barInk);chart.append(bar);
 }
 for(const h of [0,250,300,350,400]){const band=el('i','lineBand'+(h===0?' base':''));band.style.top=((480-h)/512*size)+'px';strip.append(band);}
 const cursor=el('i','lineBand cursor');cursor.id='lineBandCursor';strip.append(cursor);area.replaceChildren(strip,names);area.style.width=(size*list.length)+'px';map.replaceChildren(chart);win.scrollLeft=oldScroll;
 $('lineHint').textContent=list.length+'종 · '+dirNames[lineState.dir]+' · 셀 '+size+'px · 민트색은 공통 발선, 금색은 선택한 기준선입니다. 아래 막대는 현재 줄 안에서 추정 키 차이를 확대한 값입니다. 누르면 해당 인물로 이동합니다.';
 setLineRef(lineState.ref,false,false);
}
function rankVal(a,d,metric){const m=measure(a,d),f=optics(a,d),bd=bounds(a,d);
 switch(metric){
 case 'coreHeightDelta':return readCore(a,d).height;case 'coreCenterDelta':return readCore(a,d).center;
 case 'bodyDelta':return m.anatomicalHeight;case 'outerDelta':return bd?.[3];
 case 'faceYDelta':return f.y;case 'eyeYDelta':return f.eye?.[1];case 'faceXDelta':return f.x;
 case 'faceHeightDelta':case 'faceHeight':return f.height;case 'faceWidth':return f.width;
 case 'faceScale':return f.width?Math.sqrt(f.width*f.height):null;case 'faceAspect':return f.height?f.width/f.height:null;
 case 'faceBody':return f.height&&m.anatomicalHeight?100*f.height/m.anatomicalHeight:null;
 case 'faceSkull':return f.height&&m.skull?100*f.height/m.skull[3]:null;
 }return null;}
function signed(n,digits=1){return Number.isFinite(n)?(n>0?'+':'')+fmt(n,digits):'—';}
function deltaEvidence(r,metric){if(!Number.isFinite(r.score))return '미측정';if(metric==='outerDelta')return '알파 외곽 실측';
 const u=d=>{if(metric==='coreHeightDelta')return readCore(r.a,d).heightU;if(metric==='coreCenterDelta')return readCore(r.a,d).centerU;if(metric==='bodyDelta')return measure(r.a,d).heightUncertainty;const p=optics(r.a,d).u;return Number.isFinite(p)?p*(metric==='faceHeightDelta'?2:1):null;};
 const checks=r.diffs.map((v,i)=>{const side=[2,3][i];return Number.isFinite(v)&&Number.isFinite(u(0))&&Number.isFinite(u(side))?Math.abs(v)>u(0)+u(side):null;});
 const prefix=metric==='bodyDelta'?'제작 참고폭':'판독 참고폭';return checks.includes(true)?prefix+' 초과':checks.every(v=>v===null)?'참고폭 미기록':checks.includes(null)?'한쪽만 비교':prefix+' 안';}
function rankValues(a){const delta=rankState.metric.endsWith('Delta');const vals=[0,2,3].map(d=>rankVal(a,d,rankState.metric));
 const diffs=vals.slice(1).map(v=>Number.isFinite(v)&&Number.isFinite(vals[0])?v-vals[0]:null);const ok=diffs.filter(Number.isFinite);
 const score=delta?(ok.length?Math.max(...ok.map(Math.abs)):null):rankVal(a,rankState.dir,rankState.metric);
 return {a,score,vals,diffs,ok:ok.length};}
function renderRanking(){const metric=rankState.metric,[,mp,unit,why]=rankMetrics[metric],isDelta=metric.endsWith('Delta'),list=scoped(rankState.scope).map(rankValues);
 const dir=rankState.dir;$('rankDir').hidden=isDelta;
 list.sort((a,b)=>{const x=Number.isFinite(a.score),y=Number.isFinite(b.score);if(x!==y)return x?-1:1;if(!x)return a.a.name.localeCompare(b.a.name,'ko');return (rankState.order==='desc'?b.score-a.score:a.score-b.score)||a.a.name.localeCompare(b.a.name,'ko');});
 const coverage=list.filter(r=>Number.isFinite(r.score)).length;
 $('rankHint').textContent=mp+' ('+unit+') · '+(isDelta?'정면과 좌·우 대조':dirNames[dir])+' · 비교 가능 '+coverage+' / '+list.length+'종. '+why+(isDelta?' 좌·우의 부호는 각각 측면값−정면값입니다.':'');
 const table=el('table','ranktable'),hd=table.createTHead().insertRow();
 const hs=isDelta?['순위','캐릭터','정면','왼쪽','오른쪽','왼쪽 차이','오른쪽 차이','최대 절대차','추정 참고폭','선택']:['순위','캐릭터',mp+' ('+unit+')','얼굴창 폭×높이','얼굴 중심 (X,Y)','눈 중심 (X,Y)','참고폭 ±px','선택'];
 for(const h of hs)hd.append(el('th','',h));const body=table.createTBody();
 for(const [i,r]of list.entries()){const a=r.a,row=body.insertRow(),f=optics(a,dir);row.append(el('td','',Number.isFinite(r.score)?String(i+1):'—'));
 const label=el('td'),jump=btn(a.name,()=>{if(metric.startsWith('core')){chooseCore(a.id,true);return;}compareFromFinding(a,null,'four',dir);if(metric.startsWith('face')||metric.startsWith('eye')){state.faceGuide=true;$('faceGuide').checked=true;refreshImages();}},'rankname');label.append(jump);row.append(label);
 if(isDelta){for(const v of r.vals)row.append(el('td',Number.isFinite(v)?'':'na',fmt(v)));for(const v of r.diffs)row.append(el('td','',signed(v)));row.append(el('td','delta',fmt(r.score)+(r.ok===1?' (한쪽)':'')),el('td','',deltaEvidence(r,metric)));
 }else{const pair=p=>p?p.map(v=>fmt(v)).join(', '):'—';for(const t of [fmt(r.score,metric==='faceAspect'?2:1),f.box?fmt(f.width)+' × '+fmt(f.height):'—',f.box?pair([f.x,f.y]):'—',pair(f.eye),fmt(f.u)])row.append(el('td','',t));if(f.note)row.title=f.note;}
 const td=el('td'),p=btn(state.pins.includes(a.id)?'고정됨':'추가',()=>togglePin(a.id),'rankpin');p.setAttribute('aria-pressed',String(state.pins.includes(a.id)));p.setAttribute('aria-label',a.name+' 비교 선택 전환');td.append(p);row.append(td);}
 $('rankTable').replaceChildren(table);
}
function renderFaceMetrics(arr,ds){
 const out=$('metricsTable');out.replaceChildren();$('metricDesc').textContent='같은 배율로 판독한 드러난 얼굴과 보이는 눈의 위치 · 512px 셀';
 if(arr.length){const tab=el('table','metricstable'),head=tab.createTHead().insertRow();for(const t of ['캐릭터','방향','얼굴 폭×높이','가로/세로','얼굴 높이/키','얼굴 높이/두개부','얼굴 중심 X,Y','눈 중심 X,Y','참고폭 ±px'])head.append(el('th','',t));const tbody=tab.createTBody();
 for(const a of arr)for(const d of ds){const f=optics(a,d),row=tbody.insertRow();if(f.note)row.title=f.note;const pct=n=>Number.isFinite(n)?fmt(n)+'%':'—';const values=[a.name,dirNames[d],f.box?fmt(f.width)+' × '+fmt(f.height):'—',fmt(rankVal(a,d,'faceAspect'),2),pct(rankVal(a,d,'faceBody')),pct(rankVal(a,d,'faceSkull')),f.box?fmt(f.x)+', '+fmt(f.y):'—',f.eye?f.eye.map(v=>fmt(v)).join(', '):'—',fmt(f.u)];for(const t of values)row.append(el('td','',t));}
 out.append(tab);}else out.append(el('p','hint','전체판에서 캐릭터를 선택하세요.'));
 $('measureNote').textContent='분홍 상자는 보이는 볼·이마·눈·코·턱의 외접 범위입니다. 뿔·귀·모자·목과 머리카락 부피는 제외했습니다. 상자 안에는 일부 앞머리 등도 포함될 수 있습니다. —는 후면이나 가림 등으로 판독할 수 없는 항목입니다.';
}
function initLineTools(){opts($('lineDir'),dirNames.map((n,i)=>[String(i),n]),'0');opts($('rankDir'),dirNames.map((n,i)=>[String(i),n]),'0');
 opts($('rankMetric'),Object.entries(rankMetrics).map(([id,info])=>[id,info[0]]),rankState.metric);
 for(const [id,key] of [['lineScope','scope'],['lineOrder','order'],['lineZoom','zoom'],['lineDir','dir']])on(id,'change',()=>{lineState[key]=key==='dir'?Number($(id).value):$(id).value;renderLineup();});
 on('lineRef','change',()=>setLineRef($('lineRef').value,true));on('lineFeature','change',()=>{lineState.feature=$('lineFeature').value;drawLineMarks();});
 on('lineHeight','input',()=>{lineState.height=Number($('lineHeight').value);lineState.feature='manual';$('lineFeature').value='manual';drawLineMarks();});
 on('freezeLine','click',()=>{const y=linePoint();if(!Number.isFinite(y))return;
  const label=lineState.feature==='manual'?'직접 그은 선':byId.get(lineState.ref).name+' '+dirNames[lineState.dir]+' '+({eye:'눈',chin:'턱',crown:'정수리'}[lineState.feature]);
  if(lineState.lines.some(l=>l.y===y&&l.label===label))return;const colors=['#ffacd1','#9fe2fb','#bdc0ff','#f1e99a'];lineState.lines.push({y,label,color:colors[lineState.lines.length%colors.length]});drawLineMarks();});
 for(const [id,key] of [['rankMetric','metric'],['rankScope','scope'],['rankOrder','order'],['rankDir','dir']])on(id,'change',()=>{rankState[key]=key==='dir'?Number($(id).value):$(id).value;renderRanking();});
 on('measureKind','change',renderMetrics);
 let last=0;new ResizeObserver(()=>{const w=$('lineWindow').clientWidth;if(w!==last){last=w;if(lineState.zoom==='fit')renderLineup();}}).observe($('lineWindow'));
}

'use strict';
const coreState={id:'phantom',filter:'all',order:'priority',turn:0,size:96,tipSlack:8,bodyDrop:12};
const coreDecisions={repair:'수정 우선',review:'추가 대조',occluded:'가림·유보',keep:'현행 유지'};
const corePriority={repair:0,review:1,occluded:2,keep:3};
const coreLead=['phantom','time_magician','lightning_sage','ancient_dragon','night_rabbit','ash','guardian','antropy','luna'];
const ink={head:'#91f2d8',eye:'#ffe185',tip:'#ffb4d6',ref:'#fff2c4'};
function readCore(a,d){return SDHeadAudit.measure(a.core?.views[d],optics(a,d).eye);}
function coreDiff(a,d){return SDHeadAudit.pair(readCore(a,0),readCore(a,d));}
function deltaMagnitude(a,key){const values=[2,3].map(d=>coreDiff(a,d)[key]).filter(Number.isFinite);return values.length?Math.max(...values.map(Math.abs)):null;}
function sameTipPattern(a,d){const p=coreDiff(a,d);return a.core.views[d].kind==='hair'&&Number.isFinite(p.tipAgainstFront)&&Number.isFinite(p.height)&&Number.isFinite(p.crown)&&Math.abs(p.tipAgainstFront)<=coreState.tipSlack&&p.crown>=coreState.bodyDrop&&-p.height>=coreState.bodyDrop;}
function coreMatches(a){if(coreState.filter==='changed')return Boolean(a.revision);return coreState.filter==='all'||(coreState.filter==='signature'?[2,3].some(d=>sameTipPattern(a,d)):coreState.filter===a.core.decision);}
function coreOrder(a,b){
 if(coreState.order==='release'&&Boolean(a.revision)!==Boolean(b.revision))return a.revision?-1:1;
 if(!['priority','release'].includes(coreState.order)){const x=deltaMagnitude(a,coreState.order),y=deltaMagnitude(b,coreState.order);
   if(x!==y)return x==null?1:y==null?-1:y-x;}
 const k=corePriority[a.core.decision]-corePriority[b.core.decision];if(k)return k;
 const rank=id=>coreLead.includes(id)?coreLead.indexOf(id):999;
 return rank(a.id)-rank(b.id)||a.name.localeCompare(b.name,'ko');
}
function chooseCore(id,scroll=false){
 const a=byId.get(id);if(!a?.core)return;
 if(!coreMatches(a)){coreState.filter='all';$('coreFilter').value='all';}
 coreState.id=id;coreState.turn=0;$('coreWho').value=id;renderCoreDetail();renderCoreTable();
 if(scroll)$('core').scrollIntoView({block:'start'});
}
function pinCorePoint(ctx,p,color){
 if(!p)return;ctx.beginPath();ctx.arc(p[0],p[1],3.7,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();ctx.lineWidth=1.6;ctx.strokeStyle='#1e2935';ctx.stroke();
}
function coreDrawing(a,d){
 const c=el('canvas','core-canvas');const box=[82,24,348,324],ratio=1.5;
 c.width=box[2]*ratio;c.height=box[3]*ratio;
 c.setAttribute('role','img');c.setAttribute('aria-label',a.name+' '+dirNames[d]+' 고정 얼굴 확대');
 const quality=state.quality,marks=$('coreMarks').checked,lines=$('coreLines').checked,ellipse=$('coreEllipse').checked;
 const tone=state.tone,bg=grounds[state.bg][1];
 imgFor(a,quality).then(im=>{
  const ctx=c.getContext('2d'),cell=im.naturalWidth/2;ctx.scale(ratio,ratio);ctx.translate(-box[0],-box[1]);
  ctx.fillStyle=bg;ctx.fillRect(...box);ctx.imageSmoothingQuality='high';
  const draw=()=>ctx.drawImage(im,d%2*cell,Math.floor(d/2)*cell,cell,cell,0,0,512,512);
  ctx.filter=tone==='gray'?'grayscale(1)':'none';
  if(tone==='solid'){const buff=document.createElement('canvas');buff.width=buff.height=512;const off=buff.getContext('2d');
    off.drawImage(im,d%2*cell,Math.floor(d/2)*cell,cell,cell,0,0,512,512);off.globalCompositeOperation='source-in';off.fillStyle='#e0e9f1';off.fillRect(0,0,512,512);ctx.drawImage(buff,0,0);
  }else draw();ctx.filter='none';
  if(lines){ctx.save();ctx.setLineDash([6,5]);ctx.lineWidth=1.35;ctx.strokeStyle=ink.ref;ctx.shadowColor='#27313d';ctx.shadowBlur=2;
    for(const p of [a.core.views[0].crown,a.core.views[0].chin]){if(!p)continue;ctx.beginPath();ctx.moveTo(box[0],p[1]);ctx.lineTo(box[0]+box[2],p[1]);ctx.stroke();}
    ctx.restore();}
  if(ellipse){const s=measure(a,d).skull;if(s){ctx.save();ctx.setLineDash([3,4]);ctx.lineWidth=2;ctx.strokeStyle='#c7b0ff';ctx.beginPath();ctx.ellipse(s[0],s[1],s[2]/2,s[3]/2,s[4]*Math.PI/180,0,Math.PI*2);ctx.stroke();ctx.restore();}}
  if(marks){const v=a.core.views[d];pinCorePoint(ctx,v.tip,ink.tip);pinCorePoint(ctx,optics(a,d).eye,ink.eye);pinCorePoint(ctx,v.crown,ink.head);pinCorePoint(ctx,v.chin,ink.head);}
  c.dataset.drawn='1';
 }).catch(e=>{c.dataset.error='1';showNotice(e.message);});return c;
}
function renderCorePics(){const a=byId.get(coreState.id);renderReleaseRow(a);$('corePics').replaceChildren(...[0,2,3].map(d=>{
 const button=btn('',()=>{coreState.turn=d;renderCoreMini();},'core-frame');button.dataset.dir=d;button.setAttribute('aria-label',a.name+' '+dirNames[d]+' 전신 보기');
 const label=el('span','core-direc',dirNames[d]),h=readCore(a,d).height;
 label.append(el('b','',Number.isFinite(h)?fmt(h)+' px':'윗선·턱 판독 유보'));button.append(coreDrawing(a,d),label);return button;
}));}
function renderCoreMini(){
 const a=byId.get(coreState.id),d=coreState.turn;
 const c=el('canvas','core-mini-canvas');c.width=c.height=coreState.size;c.style.width=c.style.height=coreState.size+'px';
 c.setAttribute('role','img');c.setAttribute('aria-label',a.name+' '+dirNames[d]+' 전장 배포본 '+coreState.size+'px 전신');
 c.style.backgroundColor=grounds[state.bg][1];imgFor(a,'game').then(im=>{const ctx=c.getContext('2d'),half=im.naturalWidth/2;ctx.imageSmoothingQuality='high';ctx.drawImage(im,d%2*half,Math.floor(d/2)*half,half,half,0,0,c.width,c.height);c.dataset.drawn='1';}).catch(e=>showNotice(e.message));
 $('coreMini').replaceChildren(c);updatePressed($('coreFlipControls'),d);
 for(const f of $('corePics').children)f.setAttribute('aria-pressed',String(+f.dataset.dir===d));
}
const coreLabels=[['height','실효 머리 높이'],['center','머리 중심 Y'],['crown','본체 윗선 Y'],['chin','턱 Y'],['eye','동공 Y'],['width','본체 투영 폭'],['extension','돌출 여유¹']];
function addHeaders(table,items){const row=table.createTHead().insertRow();for(const label of items){const h=el('th','',label);h.scope='col';row.append(h);}}
function renderCoreDetail(){
 const a=byId.get(coreState.id),ver=a.core;$('coreWho').value=a.id;
 $('coreDecision').className='core-badge '+ver.decision;$('coreDecision').textContent=coreDecisions[ver.decision];$('coreSides').textContent=ver.side;
 renderCorePics();renderCoreMini();$('coreObs').textContent=ver.note;
 const front=readCore(a,0),kind={hair:'가닥',gear:'착용 장식',ear:'귀·뿔·더듬이',none:'돌출'};
 const offsets=[2,3].map(d=>{const z=coreDiff(a,d).tipAgainstFront;return dirNames[d]+' '+kind[ver.views[d].kind]+' 끝 '+(z==null?'—':signed(z)+'px');});
 $('coreSignature').textContent=front.crown==null?'정면 본체 윗선이 가려져 돌출 끝과 대조할 수 없습니다.':'정면 본체 윗선(y='+fmt(front.crown)+')에 비해 '+offsets.join(' · ')+'. 양수는 정면선보다 아래입니다.';
 $('coreAction').replaceChildren(el('b','','수정 판단 '),document.createTextNode(ver.action));
 const table=$('coreMetrics');table.replaceChildren();addHeaders(table,['512셀 · px','정면','왼쪽','오른쪽','좌 차이','우 차이']);const body=table.createTBody();
 const ds=[0,2,3],values=ds.map(d=>readCore(a,d)),delta=[2,3].map(d=>coreDiff(a,d));
 for(const [k,label] of coreLabels){const row=body.insertRow();const name=el('th','',label);name.scope='row';row.append(name);
   for(const v of values)row.append(el('td',v[k]==null?'na':'',fmt(v[k])));for(const diff of delta)row.append(el('td',diff[k]==null?'na':'',signed(diff[k])));}
 const reference=a.core.views;const margins=ds.map(d=>{const m=reference[d];return dirNames[d]+' '+(m.crown?'±'+m.u[0]:'—')+' / '+(m.chin?'±'+m.u[1]:'—');});
 const beta=delta.map((p,i)=>dirNames[[2,3][i]]+' '+(p.heightBand==null?'—':'±'+fmt(p.heightBand)+'px')).join(', ');
 $('corePrecision').textContent='윗선 / 턱의 판독 여유(px) · '+margins.join(' · ')+'. 정면과 측면 높이 차이의 합산 여유는 '+beta+'입니다. 점을 다시 찍을 때 달라질 수 있는 범위를 나타냅니다. ¹ 돌출 여유는 본체 윗선에서 표시한 가닥·귀·뿔·착용 장식의 끝까지의 세로 간격입니다.';
 const source=$('coreProvenance');source.replaceChildren(document.createTextNode('아틀라스 '+a.sourceHash.slice(0,12)+' · '),sourceLink(a.sourcePath,'보관 원본'),document.createTextNode(' · '),sourceLink(a.gamePath,'전장 배포본'));
 if(a.revision){const r=a.revision;source.append(document.createTextNode(' · '),sourceLink(r.evidence,'이번 교정과 검사 근거'),
   el('p','','실제 적용에 사용한 PNG의 독립 검출 경고 '+r.flags.before+' → '+r.flags.after+'개. 별도 공통 패킹본의 정식 17항목은 '+r.formal.pass+'개 통과, '+r.formal.caution+'개 주의입니다.'),
   sourceLink(r.formalPath,'17항목별 판정'));}
 if(a.id==='phantom'&&!a.revision){source.append(el('p','','팬텀 제작 타원 높이는 150.5 / 148.0 / 148.0px입니다. 패킹은 네 방향 모두 0.637793배이며, 제작 기록의 생성 원본과 현행 아틀라스 해시를 대조했습니다. 가닥이 본체 위로 나온 길이는 24 / 20 / 21px입니다. 같은 원본을 별도로 다시 찍은 본체 높이는 177 / 157 / 155px입니다.'),sourceLink('defense/scripts/art/pack-phantom.mjs','공통 배율을 쓰는 코드'),document.createTextNode(' · '),sourceLink('defense/docs/art/phantom-20261024/packing.json','방향별 패킹 기록'));}
}
function renderCoreTable(){
 const list=actors.filter(coreMatches).sort(coreOrder);
 const table=$('coreTable');table.replaceChildren();const name={release:'높이',priority:'높이',height:'높이',center:'중심',eye:'눈'}[coreState.order],metric=['release','priority'].includes(coreState.order)?'height':coreState.order;
 addHeaders(table,['캐릭터','판정','좌 '+name+' Δ','우 '+name+' Δ']);
 const body=table.createTBody();
 for(const a of list){const row=body.insertRow(),selected=a.id===coreState.id;
  if(selected)row.className='active';
  const td=el('td'),b=btn(a.name,()=>chooseCore(a.id),'audit-name');b.dataset.coreId=a.id;b.setAttribute('aria-pressed',String(selected));td.append(b);row.append(td);
  const label=el('td');label.append(el('span','core-status '+a.core.decision,coreDecisions[a.core.decision]));row.append(label);
  for(const d of [2,3]){const n=coreDiff(a,d)[metric];row.append(el('td',n==null?'na':'',signed(n)));}}
 $('coreCount').textContent=list.length+' / '+actors.length;$('coreThresholds').hidden=coreState.filter!=='signature';
 $('core').classList.toggle('no-core-match',!list.length);$('coreEmpty').hidden=Boolean(list.length);
 if(coreState.filter==='signature'){$('coreStats').textContent='같은 측면에서 잔머리 끝과 정면 본체 윗선의 거리가 '+coreState.tipSlack+'px 이내이며 본체 윗선 하강과 머리 높이 감소가 각각 '+coreState.bodyDrop+'px 이상인 경우 · '+(list.map(a=>a.name+' ('+[2,3].filter(d=>sameTipPattern(a,d)).map(d=>dirNames[d]).join('·')+')').join(', ')||'해당 없음')+'. 이 조건은 후보를 찾는 탐색값입니다.';}
 else if(!list.length)$('coreStats').textContent='현재 조건에 해당하는 대상이 없습니다.';
 else $('coreStats').textContent=Object.entries(coreDecisions).map(([id,name])=>name+' '+actors.filter(a=>a.core.decision===id).length+'종').join(' · ')+'. 판정은 현재 그림의 정면과 양 측면에 적용됩니다.';
}
function initCore(){
 const applied=actors.some(a=>a.revision);
 if(applied){$('coreOrder').insertBefore(new Option('이번 적용본 먼저','release'),$('coreOrder').firstChild);coreState.order='release';$('coreOrder').value='release';}
 opts($('coreWho'),actors.map(a=>[a.id,a.name]),coreState.id);opts($('coreFilter'),[['all','모든 판정'],...(applied?[['changed','이번에 고친 캐릭터']]:[]),['signature','잔머리 끝이 정면선에 닿는 유형'],...Object.entries(coreDecisions)],'all');
 on('showOldViews','change',()=>renderReleaseRow(byId.get(coreState.id)));
 segmented($('coreFlipControls'),[[0,'정'],[2,'좌'],[3,'우'],[1,'후']],0,d=>{coreState.turn=d;renderCoreMini();});
 on('coreWho','change',()=>chooseCore($('coreWho').value));
 function applyCoreFilter(){coreState.filter=$('coreFilter').value;const choice=actors.filter(coreMatches).sort(coreOrder);
   if(choice.length&&!choice.some(a=>a.id===coreState.id)){coreState.id=choice[0].id;coreState.turn=0;renderCoreDetail();}renderCoreTable();}
 on('coreFilter','change',applyCoreFilter);
 for(const [id,key] of [['coreSlack','tipSlack'],['coreDrop','bodyDrop']])on(id,'change',()=>{const input=$(id);const n=input.valueAsNumber;if(!Number.isFinite(n)){input.value=coreState[key];return;}coreState[key]=Math.max(Number(input.min),Math.min(Number(input.max),Math.round(n)));input.value=coreState[key];applyCoreFilter();});
 on('coreOrder','change',()=>{coreState.order=$('coreOrder').value;renderCoreTable();});
 for(const id of ['coreMarks','coreLines','coreEllipse'])on(id,'change',()=>{renderCorePics();renderCoreMini();});
 on('corePixels','change',()=>{coreState.size=Number($('corePixels').value);renderCoreMini();});renderCoreDetail();renderCoreTable();
}


function compareFromFinding(a,b,mode,d=0){stopTurn();state.pins=[a.id];if(b&&b.id!==a.id)state.pins.push(b.id);state.who=a.id;state.ref='';$('historical').value='';state.a='';state.b='';state.mode=mode;state.dir=d;
 state.crop='full';$('crop').value='full';updatePressed($('dirs'),d);renderSelection();if(state.analysis==='head')renderFindings();$('comparison').scrollIntoView({block:'start'});}
function findingRows(){
 const result=[],tol=state.tolerance;let examined=0;
 if(state.analysis==='height'){
 for(const a of actors){for(const b of actors){const ra=groupRank[groupOf(a)],rb=groupRank[groupOf(b)];if(ra>=rb||rb===3)continue;
 const l=measure(a,0),h=measure(b,0);if(!Number.isFinite(l.anatomicalHeight)||!Number.isFinite(h.anatomicalHeight))continue;examined++;
 const delta=l.anatomicalHeight-h.anatomicalHeight;if(delta<=tol)continue;const known=Number.isFinite(l.heightUncertainty)&&Number.isFinite(h.heightUncertainty);
 const separate=known?delta>l.heightUncertainty+h.heightUncertainty:null;
 result.push({id:a.id,a,b,delta,separate,title:a.name+' ('+groupNames[groupOf(a)]+') · '+b.name+' ('+groupNames[groupOf(b)]+')',info:'앞 캐릭터가 '+fmt(delta)+'px 큼 · '+(separate===null?'참고폭 미기록':separate?'참고폭 비중첩':'참고폭 겹침')});}}
 }else if(state.analysis==='direction'){
 for(const a of actors){const s=spread(a);if(!s)continue;examined++;if(s.diff<=tol)continue;const lo=measure(a,s.lo),hi=measure(a,s.hi);
 const known=Number.isFinite(lo.heightUncertainty)&&Number.isFinite(hi.heightUncertainty);
 result.push({a,delta:s.diff,separate:known?s.diff>lo.heightUncertainty+hi.heightUncertainty:null,title:a.name,info:dirNames[s.lo]+' '+fmt(lo.anatomicalHeight)+' · '+dirNames[s.hi]+' '+fmt(hi.anatomicalHeight)+' ('+fmt(s.diff)+'px)'});}
 }else{
 const vals=actors.map(a=>({a,s:measure(a,state.dir).skull})).filter(v=>v.s);examined=vals.length;
 const mw=med(vals.map(v=>v.s[2])),mh=med(vals.map(v=>v.s[3]));const ordered=vals.map(({a,s})=>({a,s,delta:Math.max(Math.abs(s[2]-mw),Math.abs(s[3]-mh))})).sort((x,y)=>x.delta-y.delta);const peer=ordered[0]?.a;
 for(const {a,s,delta} of ordered)if(delta>tol)result.push({a,b:a===peer?null:peer,delta,separate:null,title:a.name,info:'두개부 '+fmt(s[2])+' × '+fmt(s[3])+' · 중앙값과 최대 '+fmt(delta)+'px 차이'});
 }
 result.sort((x,y)=>Number(y.separate===true)-Number(x.separate===true)||y.delta-x.delta);return {result,examined};}
function renderFindings(){const box=$('findings');box.replaceChildren();updatePressed($('analysisModes'),state.analysis);const {result,examined}=findingRows();
 const groupSummary=['short','medium','tall'].map(g=>fmt(med(actors.filter(a=>groupOf(a)===g).map(a=>measure(a,0).anatomicalHeight)))).join(' / ');
 const notes={height:'정면 정수리~발 추정 키. 작은·보통·큰 키군 중앙값 '+groupSummary+'px. 낮은 키군이 높은 키군보다 설정한 여유를 초과해 클 때 표시합니다.',direction:'한 캐릭터의 네 방향의 제작 정수리~발 추정치 중 최댓값과 최솟값입니다. 실효 머리의 방향 차이는 상단의 머리 판독표에서 확인하세요.',head:dirNames[state.dir]+'에서 전체 캐스트의 두개부 폭·높이 중앙값을 구하고, 어느 한 축이라도 설정한 여유를 넘는 캐릭터를 표시합니다. 기준점을 수동 추정한 기록입니다.'};$('analysisNote').textContent=notes[state.analysis];
 const strictRelevant=state.analysis!=='head';
 if(strictRelevant){const lab=el('label','tick');const check=el('input');check.type='checkbox';check.checked=state.strict;check.id='strictCheck';check.onchange=()=>{state.strict=check.checked;state.showAll=false;renderFindings();};lab.append(check,document.createTextNode('추정 참고폭이 겹치지 않는 경우만'));box.append(lab);}
 const shown=state.strict&&strictRelevant?result.filter(r=>r.separate===true):result;
 const totals=el('p','hint','비교 '+examined+(state.analysis==='height'?'쌍':'종')+' · 조건에 해당 '+shown.length+(state.analysis==='height'?'쌍':'종'));totals.style.margin='5px 0';box.append(totals);
 if(!shown.length){box.append(el('p','hint','이 조건으로 표시할 차이가 없습니다. 실제 인상과 선·채색은 선택 비교에서 확인할 수 있습니다.'));return;}
 const list=el('div','findlist');for(const r of (state.showAll?shown:shown.slice(0,5))){const row=el('div','finding'),t=el('div');t.append(el('b','',r.title),el('div','diff',r.info));
 row.append(t,btn('비교',()=>compareFromFinding(r.a,r.b,state.analysis==='direction'?'four':'one',state.analysis==='head'?state.dir:0),'linkbtn'));list.append(row);}box.append(list);
 if(shown.length>5)box.append(btn(state.showAll?'다섯 건만 보기':'전체 '+shown.length+'건 펼치기',()=>{state.showAll=!state.showAll;renderFindings();},'linkbtn'));
}
function renderReviewArt(){const a=byId.get(state.who)||actors[0];const row=$('reviewArt');row.replaceChildren();for(let d=0;d<4;d++){const item=el('div','reviewview');item.append(sprite(a,d,80,{crop:'full'}),el('span','',dirNames[d]));row.append(item);}}
function renderReview(){const a=byId.get(state.who)||actors[0];state.who=a.id;$('reviewWho').value=a.id;renderReviewArt();
 const r=reviewFor(a),v=verdict(a);$('whoStatus').textContent=v==='pass'?'5항목 모두 적합':v==='revisit'?'재검토 항목 있음':axisInfo.filter(([id])=>(r.axes[id]||'pending')!=='pending').length+' / 5항목 검토';
 $('memo').value=r.note;const box=$('reviewAxes');box.replaceChildren();for(const [id,label,guide] of axisInfo){const c=el('div','axis'),lab=el('label','',label);lab.htmlFor='axis_'+id;const sel=el('select');sel.id='axis_'+id;
 opts(sel,Object.entries(statuses),r.axes[id]||'pending');sel.onchange=()=>{const item=reviewFor(a);item.axes[id]=sel.value;records[a.id]=item;save();renderReview();renderRoster();renderProgress();$('axis_'+id).focus({preventScroll:true});};c.append(lab,el('p','',guide),sel);box.append(c);}renderProgress();saveLabel();
}
function exportRecords(){const payload={format:'star-garden-review-v1',commit:D.commit,exportedAt:new Date().toISOString(),records};
 const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob),a=el('a');a.href=u;a.download='별빛정원-SD-검토-'+D.commit.slice(0,7)+'.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1000);}
async function importRecords(file){if(!file)return;try{if(file.size>2000000)throw Error('2MB 이하의 비교실 JSON을 선택하세요.');
 const doc=JSON.parse(await file.text());if(doc.format!=='star-garden-review-v1'||![D.commit,D.previousCommit].filter(Boolean).includes(doc.commit))throw Error('같은 버전의 비교실에서 내보낸 JSON을 선택하세요.');
 const incoming=doc.commit===D.commit?cleanImport(doc.records):stableOlderRecords(doc.records);Object.assign(records,incoming);save();renderReview();renderRoster();showNotice(Object.keys(incoming).length+'종의 판정을 불러왔습니다.');
 }catch(e){showNotice(e.message);}finally{$('importFile').value='';}}
const github='https://github.com/romarin0325-cell/Studying/blob/';
function sourceLink(path,label,commit=D.commit){const a=el('a','',label);a.href=github+commit+'/'+path;a.target='_blank';a.rel='noopener noreferrer';return a;}
function info(){const box=$('infoBody');box.replaceChildren();const p=t=>box.append(el('p','',t)),h=t=>box.append(el('h3','',t));
 h('현재 게임이 사용하는 그림');p('동료 '+actors.filter(a=>a.kind==='hero').length+'명과 추가 변신 '+actors.filter(a=>a.kind==='form').length+'종입니다. 기본 캐릭터가 변신 목록에도 등록된 경우 한 번만 셌습니다. 일반판과 Bright판 HTML에 내장된 배포 이미지 및 보관 원본을 에셋 매니페스트의 SHA-256과 대조했습니다. 이 파일 안에 모든 그림이 들어 있습니다.');
 p('보스 '+D.excludedBosses.length+'종은 보스 시트의 단일 프레임을 사용합니다. 네 방향 동료 비교 범위는 46종입니다.');box.append(sourceLink(D.manifestPath,'배포 이미지 매니페스트'),document.createTextNode(' · '),sourceLink('defense/src/data.js','게임 등록'),document.createTextNode(' · '),sourceLink('defense/src/new-companions.js','추가 동료·변신'));
 h('무엇을 재는가');p('공통 512×512 셀에서 발 기준은 (256,480)입니다. 전장 배포본은 같은 좌표로 환산해 표시합니다. 개별 그림을 외곽에 맞춰 확대하지 않습니다. 64·96px은 셀의 표시 폭입니다. 전신의 불투명한 부분은 이보다 작습니다.');
 p('두개부는 귀·뿔·모자·머리카락 부피를 제외한 회전 타원입니다. 정수리 마크가 있으면 그 높이를, 없으면 타원의 화면상 최상단을 씁니다. 정수리~발은 화면에 투영된 높이이며 발·관절이 가려져 있으면 추정이 포함됩니다. 기록된 정수리·접지의 오차를 반영한 참고폭은 통계적 신뢰구간이 아닙니다. 키군은 기본 동료는 게임 등록, 추가 변신은 제작 문서에서 가져왔습니다.');
 p('두개부 면적은 패킹 자체에서 정규화합니다. 같은 눈 크기·볼 곡선·얼굴 인상까지 같다는 증거로 쓸 수 없습니다. 전신 외곽은 알파 32 이상인 픽셀의 경계이므로 장식을 포함합니다. 키의 순서와 구별해 읽으세요. 눈~턱은 그 방향에 실제 눈 기준점이 남은 경우에만 표시합니다.');
 h('실효 얼굴과 눈의 관찰');p('현재 보관 원본의 정면과 양 측면을 512px 셀에서 직접 판독했습니다. 분홍색 상자는 보이는 볼·이마·눈·코·턱을 둘러싸는 범위로 귀·모자·뿔·목·머리카락의 바깥 부피를 제외합니다. 직사각형 안에는 앞머리나 장비 일부가 들어갈 수 있습니다. 금색 점은 보이는 동공들의 중심입니다. 눈 하나만 보이면 그 한 점을 씁니다. 후면과 가려져 판독할 수 없는 항목은 비워 두었습니다. 각 방향의 참고폭은 판독 오차의 추정입니다.');
 p('한 줄의 금색 선은 공통 발선에서 잰 화면상 높이를 나타냅니다. 방향 순위의 양수는 측면값이 더 큼을 뜻합니다. 얼굴 중심 Y와 눈의 Y는 아래로 갈수록 커집니다. 수평 이동·한쪽 눈만 보이는 투영·장식에 의한 가림도 순위에 영향을 줍니다.');
 h('실효 머리 판독');p('46종의 정·좌·우를 같은 배율로 보고 조밀한 윗머리, 턱, 관자 부근 폭, 개별 돌출을 다시 표시했습니다. 가려진 지점은 비워 둡니다. 발 정렬에서 머리 중심과 크기가 각각 어떻게 달라지는지 확인하세요.');
 h('세이렌으로 확인한 버전 차이');p('2026년 11월 18일 로컬 비교판의 현재 세이렌 행은 10월 cast-v2 그림과 대응했습니다. 아래는 각 커밋에서 읽은 실제 파일입니다. 같은 512px 셀에서 측면 외곽이 정면보다 53px 작았던 10월판과 현재 설치본을 대조할 수 있습니다.');
 const hist=el('div','histgrid');hist.append(el('span'),...dirNames.map(n=>el('span','',n)));
 for(const [label,a] of [['#561 당시',byId.get('ref_siren')],['10월 cast-v2',D.octSiren],['현재 NEW4',byId.get('siren')]]){hist.append(el('span','',label));for(let d=0;d<4;d++)hist.append(sprite(a,d,72,{crop:'full',tone:'color',guide:false,quality:'source'}));}
 const wrap=el('div','histscroll');wrap.append(hist);box.append(wrap);p('장식 포함 정면 / 후면 / 좌 / 우 높이(px). #561 시점 372 / 372 / 378 / 378, 10월판 393 / 394 / 340 / 340, 현행 392 / 392 / 400 / 400. 실제 머리 크기는 별도로 판단합니다.');
 box.append(sourceLink('defense/docs/art/expansion/GENERATION_LOG.json','#561 실제 생성 지시',D.references[0].sourceCommit),document.createTextNode(' · '),sourceLink('defense/docs/art/selected-cast-20261108/README.md','11월 선택본 기록'),document.createTextNode(' · '),sourceLink('defense/docs/art/sd-pipeline/RUNBOOK.md','A–G 제작 공정'));
 h('비교하는 방법');p('먼저 64·96px 전신에서 눈과 얼굴이 읽히는지 보고, 같은 키군·체형 동료와 고정 얼굴창을 비교하세요. 회색조로 그림자 경계와 하이라이트 밀도를 보면 의상 고유색의 차이를 분리할 수 있습니다. 좌우 대조에서 가르마·장비를 든 손·고정 광원에 따른 차이도 함께 보세요. 다섯 항목 모두 적합을 선택해야 전체판의 해당 캐릭터가 적합으로 표시됩니다.');
 const detail=el('details');detail.append(el('summary','','현재 캐릭터별 파일과 측정 근거 ('+actors.length+'종)'));const list=el('div','sourceslist');
 for(const a of actors){const p=el('p','');p.append(el('strong','',a.name+' '),document.createTextNode(groupNames[groupOf(a)]+' · '),sourceLink(a.sourcePath,'보관 원본'),document.createTextNode(' · '),sourceLink(a.gamePath,'배포본'));
 if(a.measure.source)p.append(document.createTextNode(' · '),sourceLink(a.measure.source,'측정 기록'));p.append(document.createTextNode(' · SHA-256 '+a.sourceHash.slice(0,12)+' / '+a.gameHash.slice(0,12)));list.append(p);}detail.append(list);box.append(detail);
 const work=el('details');work.append(el('summary','','#561 이후 제작 기록과 권장 시험'));
 const cite=(url,label)=>{const a=el('a','',label);a.href=url;a.target='_blank';a.rel='noopener noreferrer';return a;};
 const paragraph=(text,...links)=>{const p=el('p','',text+' ');links.forEach((l,i)=>{if(i)p.append(document.createTextNode(' · '));p.append(l);});work.append(p);};
 paragraph('#561의 생성 기록은 루나 시트에 선·셀 명암, 2D 가이드에 비율, 캐릭터 원화에 정체성과 의상을 맡겼습니다. 7종 중 5종에는 턱 아래 몸을 다시 그리는 후속 편집이 기록됐습니다. 실제 지시는 좌·우 profile을 사용합니다. 3/4로 각도를 바꾸는 선택은 독립적으로 검증할 제작 변수입니다.',sourceLink('defense/docs/art/expansion/GENERATION_LOG.json','최초 제작 로그',D.references[0].sourceCommit));
 paragraph('현행 A–G 기본 템플릿은 세이렌 정면 크롭·구조·원화·기존 정면 얼굴을 입력합니다. 사용자가 별도 job으로 순서와 참조를 바꿀 수 있습니다. A–G는 측정·보호 합성·패킹·검수 결과를 추적합니다. 작업자가 실패 원인을 식별하고 다음 후보의 변경 범위를 정해야 합니다.',sourceLink('defense/scripts/art/sd-pipeline/init-brief.mjs','실제 기본 입력'),sourceLink('defense/docs/art/time-magician-left-20261109/README.md','한 방향만 교체한 사례'));
 paragraph('OpenAI는 Images 2.6의 Codex 제공, 정밀 편집과 반복 편집에서의 보존 향상을 설명합니다. API의 Sunburst는 디테일과 편집 일관성, Flare는 빠른 시안 생성에 초점을 둡니다. 같은 캐릭터의 반복 생성과 정밀 배치는 알려진 한계입니다. 당시 개별 호출의 내부 모델과 난수는 로그에서 식별할 수 없습니다.',cite('https://openai.com/index/introducing-images-2-6/','Images 2.6 발표'),cite('https://developers.openai.com/api/docs/guides/image-generation','생성 및 편집 가이드'));
 paragraph('Astra는 복잡한 시각 판단과 다단계 도구 작업에, Terra는 빠른 반복 관찰과 컴퓨터 조작에 활용할 수 있습니다. 프로그램은 픽셀·알파·기준점 간 거리를 잴 수 있고, 가려진 두개부와 의상의 의도는 그림을 보며 판단해야 합니다.',cite('https://openai.com/index/gpt-6-astra/','GPT-6 Astra'),cite('https://openai.com/index/introducing-gpt-6-1-terra/','GPT-6.1 Terra'));
 paragraph('다음 제작 시험은 체리프린스 한 명으로 시작할 수 있습니다. 이 PC의 원화는 11월 제작 입력과 해시가 일치합니다. #561 당시의 원화 입력 바이트와 정확한 구조 가이드 키 버전은 미확인입니다. 복원 가능한 #561 조건을 기준으로 삼아 원화·구조·지시·호출 수를 고정하고, 같은 루나 시트의 전체 네 방향과 정면 크롭만 바꿔 비교합니다. 조건명을 가리고 네 방향 모두 쓸 수 있는 후보 비율, 수정 후 새 결함, 최종 채택까지의 시간을 기록합니다. 그다음에 측면 각도 또는 국소 편집 방식 한 가지를 시험합니다.');
 paragraph('손·후드 같은 국소 오류는 승인 그림 위에 허용 부위만 합성하고 경계의 이음새를 확인합니다. 구조·장비 가림 문제가 반복되는 캐릭터는 간단한 고정 카메라 3D 회전 가이드를 시험할 수 있습니다. 단일 원화에서 보이지 않는 등 장식과 옷 안쪽은 초기에 하나의 디자인으로 결정해 네 방향에 공유합니다.',cite('https://github.com/Acly/krita-ai-diffusion/blob/main/docs/src/content/docs/selections.mdx','Krita의 영역 편집 구현'),cite('https://github.com/HermanRas/blender_3d_to_2d_isobake','Blender 회전·배율 구현'));
 box.append(work);$('infoDialog').showModal();
}
const rulerState={id:'siren',dir:0,points:[],cross:[256,256],seq:0};
function showRuler(){stopTurn();const pool=selectActors().length?selectActors():actors;opts($('rulerWho'),actors.map(a=>[a.id,a.name]),pool.some(a=>a.id===state.who)?state.who:pool[0].id);
 rulerState.id=$('rulerWho').value;rulerState.dir=state.dir;opts($('rulerDir'),dirNames.map((n,i)=>[String(i),n]),String(state.dir));rulerState.points=[];rulerState.cross=[256,256];$('rulerDialog').showModal();paintRuler();}
async function paintRuler(){const seq=++rulerState.seq,a=byId.get(rulerState.id),d=rulerState.dir,c=$('rulerCanvas'),ctx=c.getContext('2d'),im=await imgFor(a,state.quality);if(seq!==rulerState.seq)return;
 const cell=im.naturalWidth/2;ctx.clearRect(0,0,512,512);ctx.fillStyle=grounds[state.bg][1];ctx.fillRect(0,0,512,512);ctx.drawImage(im,d%2*cell,Math.floor(d/2)*cell,cell,cell,0,0,512,512);if(state.guide)drawGuides(ctx,a,d,fullWindow,512);if(state.faceGuide)opticalGuides(ctx,a,d,fullWindow,512);
 const pts=rulerState.points;ctx.lineWidth=2;ctx.strokeStyle='#ffcb62';if(pts.length===2){ctx.beginPath();ctx.moveTo(...pts[0]);ctx.lineTo(...pts[1]);ctx.stroke();}
 for(const [i,pt]of pts.entries()){ctx.beginPath();ctx.arc(...pt,4,0,Math.PI*2);ctx.fillStyle='#ffc759';ctx.fill();ctx.strokeStyle='#2d2824';ctx.stroke();ctx.fillStyle='#131b20';ctx.fillRect(pt[0]+5,pt[1]-15,15,15);ctx.fillStyle='#ffdc8c';ctx.font='12px sans-serif';ctx.fillText(String(i+1),pt[0]+9,pt[1]-4);}
 const [x,y]=rulerState.cross;ctx.strokeStyle='#baffeb';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(x-6,y);ctx.lineTo(x+6,y);ctx.moveTo(x,y-6);ctx.lineTo(x,y+6);ctx.stroke();
 $('rulerOut').textContent=pts.length===2?'가로 '+Math.abs(pts[1][0]-pts[0][0])+'px · 세로 '+Math.abs(pts[1][1]-pts[0][1])+'px · 직선 '+fmt(Math.hypot(pts[1][0]-pts[0][0],pts[1][1]-pts[0][1]))+'px · 다시 누르면 새 측정':pts.length?'첫 점 ('+pts[0].join(', ')+') · 두 번째 점을 놓으세요.':'512px 셀 · 첫 번째 점을 놓으세요.';
 if(pts.length){const sample=el('canvas');sample.width=sample.height=1;const cx=sample.getContext('2d',{willReadFrequently:true});
  const colors=pts.map(([px,py],i)=>{cx.clearRect(0,0,1,1);cx.drawImage(im,d%2*cell+Math.floor(px*cell/512),Math.floor(d/2)*cell+Math.floor(py*cell/512),1,1,0,0,1,1);
   const rgba=Array.from(cx.getImageData(0,0,1,1).data);return '점 '+(i+1)+' #'+rgba.slice(0,3).map(v=>v.toString(16).padStart(2,'0')).join('').toUpperCase()+' (알파 '+rgba[3]+')';});
  $('rulerOut').append(document.createElement('br'),document.createTextNode('선택한 이미지의 픽셀색 · '+colors.join(' / ')));}
}
function rulerPoint(p){if(rulerState.points.length===2)rulerState.points=[];rulerState.points.push([...p]);rulerState.cross=[...p];paintRuler();}
function on(id,ev,fn){$(id).addEventListener(ev,fn);}
function init(){
 $('size').value=String(state.size);
 $('releaseBranch').textContent=D.previousCommit?'측면 적용본':'main';$('shortsha').textContent=D.commit.slice(0,7);$('total').textContent=actors.length;$('rosterInfo').textContent='동료 '+actors.filter(a=>a.kind==='hero').length+'명 · 추가 변신 '+actors.filter(a=>a.kind==='form').length+'종 · '+actors.length*4+'방향';
 segmented($('dirs'),dirNames.map((n,i)=>[i,n]),0,i=>{stopTurn();setDir(i);});
 for(const [id,[name,color]]of Object.entries(grounds)){const b=btn('',()=>{state.bg=id;for(const x of $('grounds').children)x.setAttribute('aria-pressed',String(x===b));refreshImages();},'swatch');b.style.backgroundColor=color;b.setAttribute('aria-label',name);b.title=name;b.setAttribute('aria-pressed',String(id===state.bg));$('grounds').append(b);}
 segmented($('modes'),[['one','한 방향'],['four','네 방향'],['overlay','두 캐릭터 겹침'],['mirror','좌우 대조']],state.mode,v=>{state.mode=v;if(v==='four'||v==='mirror')stopTurn();renderStage();renderMetrics();});
 for(const a of D.references)$('historical').add(new Option('#561 · '+a.name,a.id));
 opts($('reviewWho'),actors.map(a=>[a.id,a.name]),state.who);
 segmented($('analysisModes'),[['height','키 순서'],['direction','방향 편차'],['head','머리 크기']],state.analysis,v=>{state.analysis=v;state.showAll=false;renderFindings();});
 for(const id of ['tone','quality'])on(id,'change',()=>{state[id]=$(id).value;refreshImages();});
 on('guide','change',()=>{state.guide=$('guide').checked;refreshImages();});
 on('faceGuide','change',()=>{state.faceGuide=$('faceGuide').checked;refreshImages();});
 for(const id of ['group','filter','order','rosterView'])on(id,'change',()=>{state[id]=$(id).value;renderRoster();});
 on('query','input',()=>{state.query=$('query').value;renderRoster();});
 on('thumb','change',()=>{state.thumb=+$('thumb').value;renderRoster();});
 on('turn','click',()=>{if(timer){stopTurn();return;}if(state.mode==='four'||state.mode==='mirror'){state.mode='one';renderStage();renderMetrics();}
 const order=[0,2,1,3];$('turn').textContent='회전 정지';$('turn').setAttribute('aria-pressed','true');timer=setInterval(()=>{setDir(order[(order.indexOf(state.dir)+1)%4]);},950);});
 on('clearPins','click',()=>{state.pins=[];renderSelection();});
 on('crop','change',()=>{state.crop=$('crop').value;renderStage();});
 on('size','change',()=>{state.size=+$('size').value;renderStage();});
 on('historical','change',()=>{state.ref=$('historical').value;renderStage();});
 on('overlayA','change',()=>{state.a=$('overlayA').value;renderStage();});on('overlayB','change',()=>{state.b=$('overlayB').value;renderStage();});
 on('blend','input',()=>{state.mix=+$('blend').value;$('blendValue').textContent=state.mix+'%';for(const n of $('stage').querySelectorAll('.ghost'))n.style.opacity=state.mix/100;});
 on('tol','input',()=>{const n=Number($('tol').value);if(!Number.isFinite(n))return;state.tolerance=Math.min(100,Math.max(0,n));state.showAll=false;renderFindings();});on('tol','change',()=>{$('tol').value=state.tolerance;});
 on('reviewWho','change',()=>{state.who=$('reviewWho').value;renderReview();});on('showWho','click',()=>{if(!state.pins.includes(state.who))state.pins.push(state.who);renderSelection();$('comparison').scrollIntoView({block:'start'});});
 on('nextWho','click',()=>{const start=actors.findIndex(a=>a.id===state.who);for(let step=1;step<=actors.length;step++){const a=actors[(start+step)%actors.length];if(verdict(a)==='pending'){state.who=a.id;renderReview();return;}}showNotice('미완료 캐릭터가 없습니다.');});
 on('memo','input',()=>{const a=byId.get(state.who),r=reviewFor(a);r.note=$('memo').value.slice(0,5000);records[a.id]=r;save();});$('memo').maxLength=5000;
 on('export','click',exportRecords);on('import','click',()=>$('importFile').click());on('importFile','change',()=>importRecords($('importFile').files[0]));
 on('sourceInfo','click',()=>{stopTurn();info();});on('openRuler','click',showRuler);
 for(const b of document.querySelectorAll('[data-close]'))b.onclick=()=>b.closest('dialog').close();
 on('rulerWho','change',()=>{rulerState.id=$('rulerWho').value;rulerState.points=[];paintRuler();});on('rulerDir','change',()=>{rulerState.dir=+$('rulerDir').value;rulerState.points=[];paintRuler();});on('resetRuler','click',()=>{rulerState.points=[];paintRuler();});
 on('rulerCanvas','click',e=>{const c=e.currentTarget,r=c.getBoundingClientRect();const val=(a,b,size)=>Math.max(0,Math.min(511,Math.floor((a-b)*512/size)));rulerPoint([val(e.clientX,r.left+c.clientLeft,c.clientWidth),val(e.clientY,r.top+c.clientTop,c.clientHeight)]);});
 on('rulerCanvas','keydown',e=>{const offsets={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]};if(e.key==='Enter'){e.preventDefault();rulerPoint(rulerState.cross);return;}const o=offsets[e.key];if(!o)return;e.preventDefault();rulerState.cross=rulerState.cross.map((p,i)=>Math.min(511,Math.max(0,p+o[i]*(e.shiftKey?10:1))));paintRuler();});
 initLineTools();initCore();document.addEventListener('visibilitychange',()=>{if(document.hidden)stopTurn();});renderSelection();renderFindings();
}
init();
</script></body></html>
