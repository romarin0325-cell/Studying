어진다. 기존 얇은 안경 중앙을 고정하고 아래턱과 목깃 접점을 별도로 확인했다."}],"decision":"review","side":"양 측면","note":"정면 실효 머리 181px, 좌 168px, 우 163px. 원본 좌 156·우 153px에 비해 회복되었으나 우측이 정면보다 18px 작게 읽힌다. 좌우 창·안경 및 양 목깃 접점 보존을 우선한 국소 후보.","action":"교정본을 적용했습니다. 오른쪽에는 정면과 볼륨 차이가 남아, 실효 머리 판정을 추가 대조로 두었습니다."},"measure":{"source":"defense/docs/art/turnaround-20261120/review.json","views":[{"skull":[234.13,227.2,160.82,149.24,0],"chin":[234.13,301.81],"sole":[256,480],"eyes":[],"crownY":152.58,"shoulders":null,"hips":null,"anatomicalHeight":327.42,"belowChin":178.19,"skullUncertainty":11.58,"heightUncertainty":14.8},{"skull":[270.15,225.91,160.82,149.24,0],"chin":[270.15,300.53],"sole":[256,480],"eyes":[],"crownY":151.29,"shoulders":null,"hips":null,"anatomicalHeight":328.71,"belowChin":179.47,"skullUncertainty":16.72,"heightUncertainty":19.94},{"skull":[253,229,151,152,0],"chin":[215,305],"sole":[253,479],"eyes":[[216,260]],"shoulders":[247,328],"hips":[248,385],"crownY":153,"anatomicalHeight":326,"belowChin":174,"skullUncertainty":13,"heightUncertainty":19},{"skull":[246,229,151,147,0],"chin":[290,302],"sole":[259,479],"eyes":[[290,258]],"shoulders":[264,327],"hips":[264,385],"crownY":155.5,"anatomicalHeight":323.5,"belowChin":177,"skullUncertainty":13,"heightUncertainty":19}],"heightClass":"tall","heightClassSource":"defense/src/data.js","targetBelowChin":200,"bodyFrame":null,"note":"가려진 두개골 폭·높이는 측면에서 약 ±13px입니다. 그림에서 보이는 밑창과 게임 발 고정점을 따로 기록했습니다."},"revision":{"previous":{"id":"prev_lightning_sage","name":"수정 전 번개의현자","kind":"hero","parent":null,"rarity":"SR","hidden":false,"heightGroup":"tall","atlasKey":"unit-lightning_sage","foot":0.9375,"renderScale":1,"portrait":{"x":234,"y":227,"size":250},"sourcePath":"defense/assets/cast-v2/lightning_sage.webp","sourceHash":"85049bdc24e0ee377c7d75a2b5263833709d72e9aa6bdef5e3f9f131c9b614e1","sourceWidth":1024,"sourceBytes":182914,"sourceData":"@repo/defense/assets/cast-v2/lightning_sage.webp","gamePath":"defense/assets/optimized/cast-v2/lightning_sage.webp